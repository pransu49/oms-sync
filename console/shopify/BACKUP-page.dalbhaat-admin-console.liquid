html#aikm body .lx-view{display:inline-flex;background:var(--x-surface-2);border:1px solid var(--x-line);border-radius:9px;padding:2px;gap:2px;}
html#aikm body .lx-view button{background:transparent !important;border:0 !important;min-height:30px !important;padding:4px 11px !important;border-radius:7px !important;color:var(--x-muted) !important;font-size:12px !important;font-weight:500 !important;display:inline-flex;align-items:center;gap:5px;box-shadow:none !important;}
html#aikm body .lx-view button.on{background:var(--x-gold-soft) !important;color:var(--x-gold) !important;box-shadow:0 0 0 1px var(--x-gold-line) !important;}
/* KPI strip (clickable) */
/* category KPI cards: Inventory / Pricing / Mapping / Catalogue */
#tab-lotsproducts .lx-kpis{position:relative;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin:0 0 14px;}
#tab-lotsproducts .lx-kc{display:flex;flex-direction:column;min-width:0;border:1px solid var(--x-line);border-radius:12px;background:var(--x-surface-2);overflow:hidden;transition:border-color .12s ease;}
#tab-lotsproducts .lx-kc.act{border-color:var(--x-gold-line);box-shadow:0 0 0 1px var(--x-gold-line);}
#tab-lotsproducts .lx-kc-h{display:flex;align-items:center;gap:7px;min-width:0;padding:7px 7px 7px 12px;border-bottom:1px solid var(--x-line);background:var(--x-surface);}
#tab-lotsproducts .lx-kc-h > .ti{font-size:15px;color:var(--x-gold);}
#tab-lotsproducts .lx-kc-t{font-size:11px;font-weight:600;letter-spacing:.09em;text-transform:uppercase;color:var(--x-text);white-space:nowrap;}
#tab-lotsproducts .lx-kc-f{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:10.5px;font-weight:600;color:var(--x-gold);background:var(--x-gold-soft);border:1px solid var(--x-gold-line);border-radius:20px;padding:1px 8px;}
html#aikm body #tab-lotsproducts .lx-kc-b{margin-left:auto;flex-shrink:0;display:inline-flex;align-items:center;gap:3px;background:transparent !important;border:1px solid var(--x-line-2) !important;box-shadow:none !important;min-height:26px !important;padding:2px 6px 2px 9px !important;border-radius:7px !important;font-size:11px !important;font-weight:500 !important;color:var(--x-text-2) !important;cursor:pointer;}
html#aikm body #tab-lotsproducts .lx-kc-b:hover,html#aikm body #tab-lotsproducts .lx-kc-b.open{border-color:var(--x-gold-line) !important;color:var(--x-gold) !important;background:var(--x-gold-soft) !important;}
#tab-lotsproducts .lx-kc-b .ti{font-size:13px;transition:transform .15s ease;}
#tab-lotsproducts .lx-kc-b.open .ti{transform:rotate(180deg);}
#tab-lotsproducts .lx-kc-g .lx-kpi-l{letter-spacing:.04em;}
#tab-lotsproducts .lx-kc-g .lx-kpi-r{white-space:normal;line-height:1.3;}
#tab-lotsproducts .lx-kc-g{display:grid;grid-template-columns:1fr 1fr;flex:1;}
#tab-lotsproducts .lx-kpi{display:flex;flex-direction:column;gap:2px;padding:9px 12px;min-width:0;cursor:pointer;position:relative;transition:background .12s ease;}
#tab-lotsproducts .lx-kpi:nth-child(odd){border-right:1px solid var(--x-line);}
#tab-lotsproducts .lx-kpi:nth-child(-n+2){border-bottom:1px solid var(--x-line);}
#tab-lotsproducts .lx-kpi.amber .lx-kpi-n{color:var(--x-amber);}
#tab-lotsproducts .lx-kpi.muted .lx-kpi-n{color:var(--x-text-2);}
#tab-lotsproducts .lx-act{display:inline-flex;gap:6px;align-items:center;}
html#aikm body #tab-lotsproducts .lx-act button{box-shadow:none !important;min-height:32px !important;border-radius:8px !important;font-size:12px !important;display:inline-flex;align-items:center;gap:6px;cursor:pointer;}
#tab-lotsproducts .lx-kpi:hover{background:var(--x-raise);}
#tab-lotsproducts .lx-kpi.on{background:var(--x-gold-soft);}
#tab-lotsproducts .lx-kpi.on::after{content:"";position:absolute;left:0;right:0;bottom:0;height:2px;background:var(--x-gold);}
#tab-lotsproducts .lx-kpi-l{font-size:10px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--x-muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
#tab-lotsproducts .lx-kpi-n{font-size:19px;font-weight:600;color:var(--x-text);font-variant-numeric:tabular-nums;line-height:1.2;}
#tab-lotsproducts .lx-kpi.green .lx-kpi-n{color:var(--x-green);}
#tab-lotsproducts .lx-kpi.red .lx-kpi-n{color:var(--x-red);}
#tab-lotsproducts .lx-kpi.gold .lx-kpi-n{color:var(--x-gold);}
#tab-lotsproducts .lx-kpi.up .lx-kpi-n{color:#E8590C;}
#tab-lotsproducts .lx-kpi.down .lx-kpi-n{color:var(--x-green);}
#tab-lotsproducts .lx-kpi.new .lx-kpi-n{color:var(--x-blue);}
#tab-lotsproducts .lx-kpi.rem .lx-kpi-n{color:var(--x-muted);}
html#aikm body #tab-lotsproducts .lx-msort{background:var(--x-blue-soft) !important;border:1px solid color-mix(in srgb,var(--x-blue) 30%,transparent) !important;color:var(--x-blue) !important;padding:4px 10px !important;font-weight:600 !important;}
html#aikm body #tab-lotsproducts .lx-mclear{background:transparent !important;border:1px solid var(--x-line-2) !important;color:var(--x-text-2) !important;padding:4px 10px !important;font-weight:500 !important;}
html#aikm body #tab-lotsproducts .lx-mclear:hover{color:var(--x-red) !important;border-color:var(--x-red) !important;}
#tab-lotsproducts .lx-dd{display:none;position:absolute;top:calc(100% + 6px);z-index:1000;width:290px;max-height:min(70vh,540px);overflow:auto;background:var(--x-surface);border:1px solid var(--x-line-2);border-top:3px solid var(--x-gold);border-radius:12px;box-shadow:0 18px 44px rgba(6,10,20,.22);padding:6px;}
#tab-lotsproducts .lx-dd-h{font-size:10px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--x-gold);padding:9px 10px 4px;}
#tab-lotsproducts .lx-dd-h:not(:first-child):not(.sub){border-top:1px solid var(--x-line);margin-top:4px;padding-top:10px;}
#tab-lotsproducts .lx-dd-h.sub{color:var(--x-muted);font-size:9.5px;padding-top:7px;}
html#aikm body #tab-lotsproducts .lx-dd .lx-di{display:flex;align-items:center;width:100%;font-size:12.5px !important;cursor:pointer;box-shadow:none !important;justify-content:flex-start;background:transparent !important;border:0 !important;min-height:0 !important;padding:7px 10px !important;border-radius:7px !important;color:var(--x-text) !important;font-weight:400 !important;text-align:left;gap:8px;}
html#aikm body #tab-lotsproducts .lx-dd .lx-di:hover{background:var(--x-raise) !important;}
html#aikm body #tab-lotsproducts .lx-dd .lx-di.on{background:var(--x-gold-soft) !important;color:var(--x-gold) !important;font-weight:600 !important;}
#tab-lotsproducts .lx-di .lx-ico{font-size:14px;width:14px;visibility:hidden;color:var(--x-gold);}
#tab-lotsproducts .lx-di.on .lx-ico{visibility:visible;}
#tab-lotsproducts .lx-di span{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
#tab-lotsproducts .lx-di b{margin-left:12px;font-size:11px;font-weight:500;color:var(--x-muted);font-variant-numeric:tabular-nums;}
/* Amazon mapping */
.lx-tag.amz{background:rgba(255,153,0,.13);color:#C2410C;border:1px solid rgba(255,153,0,.4);}
.lx-ours.amz{color:#C2410C;}
.lx-ch.amz{background:rgba(255,153,0,.08);border-color:rgba(255,153,0,.35);color:#9A3412;}
#tab-lotsproducts .lx-kpi.amz .lx-kpi-n{color:#E8590C;}
#lxTip .tt-k.amz{color:#FDBA74;}
body[data-theme="dark"] .lx-tag.amz,body[data-theme="dark"] .lx-ours.amz,body[data-theme="dark"] .lx-ch.amz{color:#FDBA74;}
/* new / removed badges */
.lx-tag{display:inline-flex;align-items:center;padding:1px 7px;border-radius:5px;font-size:10px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;white-space:nowrap;}
.lx-tag.new{background:var(--x-blue-soft);color:var(--x-blue);}
.lx-tag.map{background:var(--x-green-soft);color:var(--x-green);border:1px solid color-mix(in srgb,var(--x-green) 35%,transparent);}
.lx-ours{margin-top:3px;font-size:11px;color:var(--x-green);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:420px;}
.lx-card .lx-ours{max-width:100%;}
.lx-chs{display:flex;flex-wrap:wrap;gap:4px;margin-top:4px;}
[data-lxtip]{cursor:help;}
#lxTip{position:fixed;z-index:100000;max-width:360px;min-width:240px;background:#0F1E35;color:#E8ECF3;border:1px solid rgba(212,175,55,.35);border-top:3px solid #D4AF37;border-radius:12px;padding:12px 14px;box-shadow:0 18px 50px rgba(6,10,20,.45);font-family:"Lexend","Inter",system-ui,sans-serif;font-size:12px;line-height:1.45;pointer-events:none;opacity:0;transform:translateY(4px);transition:opacity .12s ease,transform .12s ease;}
#lxTip.show{opacity:1;transform:translateY(0);}
#lxTip .tt-k{font-size:10px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:#D4AF37;margin-bottom:8px;}
#lxTip .tt-p{padding:7px 0;border-top:1px solid rgba(255,255,255,.08);}
#lxTip .tt-p:first-of-type{border-top:0;padding-top:0;}
#lxTip .tt-n{font-weight:600;color:#FFFFFF;font-size:12.5px;}
#lxTip .tt-c{display:flex;flex-wrap:wrap;gap:4px;margin-top:5px;}
#lxTip .tt-c span{background:rgba(212,175,55,.12);border:1px solid rgba(212,175,55,.3);color:#F3E2A6;border-radius:20px;padding:1px 8px;font-size:10.5px;white-space:nowrap;}
#lxTip .tt-c span b{color:#FFFFFF;font-weight:600;margin-left:3px;}
#lxTip .tt-none{color:#8390A6;font-size:11px;margin-top:3px;}
#lxTip .tt-f{margin-top:9px;padding-top:8px;border-top:1px solid rgba(255,255,255,.08);color:#8390A6;font-size:10.5px;}
.lx-ch{display:inline-flex;align-items:center;padding:1px 7px;border-radius:20px;font-size:10.5px;font-weight:500;background:var(--x-surface-2);border:1px solid var(--x-line-2);color:var(--x-text-2);white-space:nowrap;}
.lx-ch.none{color:var(--x-muted);border-style:dashed;}
#tab-lotsproducts #lotsChannelFilter{min-width:150px;max-width:200px;min-height:36px !important;}
#tab-lotsproducts .lx-kpi.map .lx-kpi-n{color:var(--x-green);}
#tab-lotsproducts .lx-kpi.alert .lx-kpi-n{color:#7C3AED;}
#tab-lotsproducts .lx-kpi-r{font-size:10px;color:var(--x-muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:1px;}
.lx-sa{display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border-radius:6px;font-size:11px;font-weight:600;white-space:nowrap;font-variant-numeric:tabular-nums;}
.lx-sa.oos{background:var(--x-red-soft);color:var(--x-red);}
.lx-sa.back{background:var(--x-green-soft);color:var(--x-green);}
.lx-sa.up{background:var(--x-blue-soft);color:var(--x-blue);}
.lx-sa.down{background:var(--x-amber-soft);color:var(--x-amber);}
.lx-tag.rem{background:var(--x-raise);color:var(--x-muted);border:1px solid var(--x-line-2);}
.lx-card.rem{opacity:.8;border-style:dashed;}
.lx-card.rem .lx-cimg img{filter:grayscale(1);}
html#aikm body #lotsProductsTable tbody tr.lx-rem td{opacity:.8;}
html#aikm body #lotsProductsTable tbody tr.lx-newrow td:first-child{box-shadow:inset 3px 0 0 var(--x-blue);}
/* shared bits */
.lx-name{font-weight:500;font-size:13px;color:var(--x-text);line-height:1.35;}
.lx-sub{display:flex;align-items:center;gap:7px;margin-top:2px;font-size:11px;color:var(--x-muted);}
.lx-brand{font-weight:600;letter-spacing:.07em;color:var(--x-gold);font-size:10px;text-transform:uppercase;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.lx-mono{font-size:12px;color:var(--x-text-2);letter-spacing:.01em;white-space:nowrap;}
.lx-gst{display:inline-block;padding:1px 7px;border-radius:5px;font-size:10.5px;font-weight:600;background:var(--x-blue-soft);color:var(--x-blue);white-space:nowrap;}
.lx-stock{display:inline-flex;align-items:center;gap:5px;padding:2px 9px;border-radius:20px;font-size:11px;font-weight:500;white-space:nowrap;font-variant-numeric:tabular-nums;}
.lx-stock::before{content:"";width:6px;height:6px;border-radius:50%;background:currentColor;}
.lx-stock.ok{background:var(--x-green-soft);color:var(--x-green);}
.lx-stock.low{background:var(--x-amber-soft);color:var(--x-amber);}
.lx-stock.out{background:#D92D20;color:#FFFFFF;}
.lx-stock.out::before{background:#FFFFFF;}
.lx-slabs{display:flex;flex-wrap:wrap;gap:4px;}
.lx-slab{display:inline-flex;align-items:baseline;gap:5px;padding:3px 8px;border-radius:6px;border:1px solid var(--x-line);background:var(--x-surface-2);white-space:nowrap;}
.lx-slab b{font-size:12.5px;font-weight:600;color:var(--x-text);font-variant-numeric:tabular-nums;}
.lx-slab i{font-style:normal;font-size:10.5px;color:var(--x-muted);}
.lx-slab.best{border-color:var(--x-gold-line);background:var(--x-gold-soft);}
.lx-slab.best b{color:var(--x-gold);}
.lx-mrp{font-weight:500;color:var(--x-text-2);white-space:nowrap;font-variant-numeric:tabular-nums;font-size:12px;}
.lx-save{font-size:11px;font-weight:600;color:var(--x-green);white-space:nowrap;}
.lx-muted{font-size:11px;color:var(--x-muted);white-space:nowrap;}
/* price change badge */
.lx-pc{display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border-radius:6px;font-size:11px;font-weight:600;white-space:nowrap;font-variant-numeric:tabular-nums;}
.lx-pc.up{background:rgba(232,89,12,.14);color:#E8590C;}
.lx-pc.down{background:var(--x-green-soft);color:var(--x-green);}
.lx-pc s{font-weight:400;opacity:.75;}
/* table */
#lotsProductsTable{font-size:12.5px !important;}
html#aikm body #lotsProductsTable tbody td{padding:8px 12px !important;vertical-align:middle !important;}
html#aikm body #lotsProductsTable thead th{padding:9px 12px !important;font-size:10.5px !important;}
html#aikm body #lotsProductsTable tbody tr.lx-oos td{background:color-mix(in srgb,var(--x-red-soft) 70%,transparent) !important;}
html#aikm body #lotsProductsTable tbody tr.lx-oos td:first-child{box-shadow:inset 3px 0 0 #D92D20;}
html#aikm body #lotsProductsTable tbody tr.lx-oos .lx-name{color:var(--x-red);}
html#aikm body #lotsProductsTable tbody tr.lx-chg:not(.lx-oos) td:first-child{box-shadow:inset 3px 0 0 #E8590C;}
html#aikm body #lotsProductsTable tbody tr.lx-chg.lx-down:not(.lx-oos) td:first-child{box-shadow:inset 3px 0 0 var(--x-green);}
/* cards — simple */
#lotsCards{display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:12px;}
.lx-card{position:relative;background:var(--x-surface);border:1px solid var(--x-line);border-radius:12px;padding:14px 16px;display:flex;flex-direction:column;gap:10px;transition:border-color .12s ease,box-shadow .12s ease;}
.lx-card:hover{border-color:var(--x-gold-line);box-shadow:0 4px 14px rgba(0,0,0,.10);}
.lx-card::before{content:"";position:absolute;left:0;top:12px;bottom:12px;width:3px;border-radius:0 3px 3px 0;background:transparent;}
.lx-card.oos{background:color-mix(in srgb,var(--x-red-soft) 55%,var(--x-surface));border-color:color-mix(in srgb,#D92D20 35%,var(--x-line));}
.lx-card.oos::before{background:#D92D20;}
.lx-card.oos .lx-name{color:var(--x-red);}
.lx-card.chg:not(.oos){border-color:rgba(232,89,12,.45);}
.lx-card.chg:not(.oos)::before{background:#E8590C;}
.lx-card.chg.down:not(.oos){border-color:color-mix(in srgb,var(--x-green) 45%,var(--x-line));}
.lx-card.chg.down:not(.oos)::before{background:var(--x-green);}
.lx-card-top{display:flex;justify-content:space-between;align-items:center;gap:8px;min-width:0;}
.lx-card .lx-name{font-size:14px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:38px;}
.lx-ids{display:flex;flex-wrap:wrap;gap:4px 14px;margin-top:6px;font-size:12px;color:var(--x-text-2);font-variant-numeric:tabular-nums;}
.lx-ids em{font-style:normal;font-size:10px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--x-muted);margin-right:5px;}
html#aikm body #tab-lotsproducts .lx-ids .lx-mono{font-size:12px;color:var(--x-text-2);}
.lx-cslabs{display:grid;grid-template-columns:repeat(auto-fill,minmax(88px,1fr));gap:6px;}
.lx-cslab{display:flex;flex-direction:column;padding:6px 10px;border-radius:8px;border:1px solid var(--x-line);background:var(--x-surface-2);}
.lx-cslab b{font-size:15px;font-weight:600;color:var(--x-text);font-variant-numeric:tabular-nums;line-height:1.2;}
.lx-cslab i{font-style:normal;font-size:10.5px;color:var(--x-muted);margin-top:1px;}
.lx-cslab.best{border-color:var(--x-gold-line);background:var(--x-gold-soft);}
.lx-cslab.best b{color:var(--x-gold);}
.lx-card-foot{display:flex;justify-content:space-between;align-items:center;gap:8px;border-top:1px solid var(--x-line);padding-top:10px;margin-top:auto;}
/* product images */
.lx-img{display:flex;align-items:center;justify-content:center;background:#FFFFFF;border:1px solid var(--x-line);overflow:hidden;flex-shrink:0;cursor:zoom-in;}
.lx-img img{width:100%;height:100%;object-fit:contain;display:block;}
.lx-img.none{background:var(--x-surface-2);color:var(--x-muted);font-size:18px;cursor:default;}
.lx-thumb{width:44px;height:44px;border-radius:8px;}
.lx-pcell{display:flex;align-items:center;gap:10px;}
.lx-cimg{height:150px;border-radius:9px;}
.lx-cimg img{padding:8px;}
#lxZoom{position:fixed;inset:0;z-index:99999;background:rgba(6,10,20,.75);display:none;align-items:center;justify-content:center;cursor:zoom-out;}
#lxZoom img{max-width:min(560px,90vw);max-height:85vh;background:#fff;border-radius:14px;padding:16px;box-shadow:0 20px 60px rgba(0,0,0,.4);}
/* text selection: dark blue, readable in light + dark mode */
html#aikm body ::selection{background:#1D4ED8 !important;color:#FFFFFF !important;}
@media (max-width:1200px){#tab-lotsproducts .lx-kpis{grid-template-columns:repeat(2,minmax(0,1fr));}}
@media (max-width:640px){#tab-lotsproducts .lx-kpis{grid-template-columns:1fr;}}

/* ===== premium SaaS KPI cards ===== */
#tab-lotsproducts .lx-kpis{gap:14px;margin:2px 0 18px;}
#tab-lotsproducts .lx-kpis .lx-kc{background:var(--x-surface);border:1px solid var(--x-line);border-radius:16px;box-shadow:0 1px 2px rgba(16,24,40,.04),0 4px 14px -6px rgba(16,24,40,.08);overflow:hidden;transition:border-color .15s ease,box-shadow .15s ease;}
#tab-lotsproducts .lx-kpis .lx-kc:hover{box-shadow:0 1px 2px rgba(16,24,40,.05),0 10px 24px -10px rgba(16,24,40,.18);}
#tab-lotsproducts .lx-kpis .lx-kc.act{border-color:var(--x-gold-line);box-shadow:0 0 0 3px color-mix(in srgb,var(--x-gold) 14%,transparent),0 8px 22px -12px rgba(16,24,40,.2);}
#tab-lotsproducts .lx-kpis .lx-kc-h{gap:10px;padding:13px 12px 12px 14px;background:transparent;border-bottom:1px solid var(--x-line);}
#tab-lotsproducts .lx-kc-ic{width:32px;height:32px;border-radius:9px;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;color:var(--cc);background:color-mix(in srgb,var(--cc) 12%,transparent);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--cc) 22%,transparent);}
#tab-lotsproducts .lx-kc-inv{--cc:#1E3A8A;} #tab-lotsproducts .lx-kc-price{--cc:#B7791F;} #tab-lotsproducts .lx-kc-map{--cc:#15803D;} #tab-lotsproducts .lx-kc-cat{--cc:#6D28D9;}
body[data-theme="dark"] #tab-lotsproducts .lx-kc-inv{--cc:#93C5FD;} body[data-theme="dark"] #tab-lotsproducts .lx-kc-price{--cc:#F2C94C;} body[data-theme="dark"] #tab-lotsproducts .lx-kc-map{--cc:#4ADE80;} body[data-theme="dark"] #tab-lotsproducts .lx-kc-cat{--cc:#C4B5FD;}
#tab-lotsproducts .lx-kc-tt{display:flex;flex-direction:column;min-width:0;gap:1px;}
#tab-lotsproducts .lx-kpis .lx-kc-t{font-size:13.5px;font-weight:600;letter-spacing:-.005em;text-transform:none;color:var(--x-text);}
#tab-lotsproducts .lx-kc-cap{font-size:11px;color:var(--x-muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
#tab-lotsproducts .lx-kpis .lx-kc-f{display:inline-block;max-width:100%;vertical-align:middle;padding:0 7px;font-size:10.5px;}
