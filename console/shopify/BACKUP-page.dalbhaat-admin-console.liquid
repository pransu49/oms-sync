<!-- ===== AIKM IDLE PAUSE: stops all Firebase reads after 10 min of no activity ===== -->
<style>
  #aikmIdleBar{position:fixed;left:50%;bottom:22px;transform:translateX(-50%) translateY(140%);z-index:2147483000;
    background:#14213d;color:#f8f1e1;border:1px solid #c9a24a;border-radius:14px;padding:12px 18px;
    font:500 14px/1.4 system-ui,-apple-system,Segoe UI,Roboto,sans-serif;box-shadow:0 10px 30px rgba(0,0,0,.25);
    display:flex;gap:10px;align-items:center;transition:transform .35s ease;max-width:calc(100% - 32px)}
  #aikmIdleBar.show{transform:translateX(-50%) translateY(0)}
  #aikmIdleBar .dot{width:9px;height:9px;border-radius:50%;background:#c9a24a;flex:none}
  #aikmIdleBar.live .dot{background:#3fa36b}
</style>
<div id="aikmIdleBar"><span class="dot"></span><span id="aikmIdleTxt"></span></div>
<script>
(function () {
  var IDLE_MS = 10 * 60 * 1000;          // 10 minutes
  var last = Date.now(), paused = false, hideT = null;
  var bar = document.getElementById('aikmIdleBar'), txt = document.getElementById('aikmIdleTxt');

  function show(msg, live, autoHide) {
    txt.textContent = msg;
    bar.classList.toggle('live', !!live);
    bar.classList.add('show');
    clearTimeout(hideT);
    if (autoHide) hideT = setTimeout(function () { bar.classList.remove('show'); }, 2500);
  }
  function eachDb(fn) {
    if (!window.firebase || !firebase.apps) return;
    firebase.apps.forEach(function (app) {
      try { var p = fn(app.firestore()); if (p && p.catch) p.catch(function () {}); } catch (e) {}
    });
  }
  function pause() {
    if (paused) return;
    paused = true;
    eachDb(function (db) { return db.disableNetwork(); });
    show('Live sync paused (idle 10 min) — move mouse or press any key to resume', false, false);
  }
  function resume() {
    last = Date.now();
    if (!paused) return;
    paused = false;
    eachDb(function (db) { return db.enableNetwork(); });
    show('Live sync resumed', true, true);
  }
  ['mousemove', 'mousedown', 'keydown', 'touchstart', 'wheel', 'scroll'].forEach(function (ev) {
    window.addEventListener(ev, resume, { passive: true, capture: true });
  });
  document.addEventListener('visibilitychange', function () { if (!document.hidden) resume(); });
  setInterval(function () { if (!paused && Date.now() - last > IDLE_MS) pause(); }, 30000);
})();
</script>
<!-- ===== END AIKM IDLE PAUSE ===== -->
<script>
/* Complaints tab: load the tool only on first open, so the console stays fast */
document.addEventListener("click", function (e) {
