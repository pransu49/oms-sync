<style id="aikm-premium-ui">
/* =====================================================================
   AIKM PHARMA — Admin Console · Premium UI v3 (Sep 2026)
   One clean design layer on top of the old styles. Visual only:
   no layout logic, no show/hide rules, no animations → no lag, no function changes.
   ===================================================================== */

@media screen{
/* ---------- Design tokens (dark = default, light = toggle) ---------- */
html#aikm body{
  --x-bg:#0B1220; --x-surface:#111A2B; --x-surface-2:#0E1626; --x-raise:#16213A;
  --x-line:#1E2A40; --x-line-2:#2A3752;
  --x-text:#E8ECF3; --x-text-2:#B7C0D0; --x-muted:#8390A6;
  --x-gold:#D4AF37; --x-gold-2:#E9CC6E; --x-gold-soft:rgba(212,175,55,.12); --x-gold-line:rgba(212,175,55,.35);
  --x-green:#3FB57A; --x-green-soft:rgba(63,181,122,.12);
  --x-red:#F0787A; --x-red-soft:rgba(240,120,122,.12);
  --x-amber:#F2B84B; --x-amber-soft:rgba(242,184,75,.12);
  --x-blue:#7AA7FF; --x-blue-soft:rgba(122,167,255,.12);
  --x-primary:#D4AF37; --x-primary-ink:#1A1405;
  --x-shadow:0 1px 2px rgba(0,0,0,.35);
  --x-radius:12px; --x-radius-sm:8px;
  --x-side:#08101E; --x-side-line:#172238; --x-side-text:#A7B1C4; --x-side-hi:#F3E2A6;
  --x-font:"Inter",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  --x-brand-font:"Lexend","Inter",sans-serif;
  /* remap the old variable families so inline styles follow the new palette */
  --muted:var(--x-muted); --line:var(--x-line); --navy:#0F1E35; --gold:var(--x-gold);
  --shell-text:var(--x-text); --shell-text-dim:var(--x-text-2); --shell-text-mute:var(--x-muted);
  --shell-line:var(--x-line); --shell-line-hi:var(--x-line-2); --shell-card:var(--x-surface); --shell-card-hi:var(--x-raise);
  --shell-bg:var(--x-bg); --shell-bg2:var(--x-surface-2);
  --om-muted:var(--x-muted); --om-line:var(--x-line); --om-green:var(--x-green); --om-red:var(--x-red);
}
html#aikm body[data-theme="light"]{
  --x-bg:#F5F4F0; --x-surface:#FFFFFF; --x-surface-2:#FAF9F6; --x-raise:#F3F1EB;
  --x-line:#E6E2D8; --x-line-2:#D8D3C6;
  --x-text:#14213A; --x-text-2:#3A4760; --x-muted:#6B7385;
  --x-gold:#B8901F; --x-gold-2:#9A7614; --x-gold-soft:#FBF4DF; --x-gold-line:#E8D494;
  --x-green:#1F7A4D; --x-green-soft:#E7F4EC;
  --x-red:#B42318; --x-red-soft:#FDECEA;
  --x-amber:#A15C07; --x-amber-soft:#FEF3DC;
  --x-blue:#2554C7; --x-blue-soft:#E9EFFD;
  --x-primary:#0F1E35; --x-primary-ink:#FFFFFF;
  --x-shadow:0 1px 2px rgba(16,24,40,.05),0 1px 3px rgba(16,24,40,.04);
}

/* ---------- Base ---------- */
html#aikm, html#aikm body{background:var(--x-bg) !important;}
html#aikm body{padding:0 !important;margin:0 !important;}
html#aikm body{color:var(--x-text) !important;font-family:var(--x-font) !important;font-size:13.5px;-webkit-font-smoothing:antialiased;letter-spacing:0 !important;}
html#aikm body :is(input,select,textarea,button,table,td,th,h1,h2,h3,h4,p,span,div,a,label,small,b,strong){font-family:inherit;letter-spacing:normal;}
html#aikm body :is(.orb,.orb1,.orb2,.orb3,.hero-glow,.sparkle,.hero-underline,.theme-reveal){display:none !important;}
html#aikm body ::selection{background:var(--x-gold-soft);}
html#aikm body *:focus-visible{outline:2px solid var(--x-gold) !important;outline-offset:1px;}

/* ---------- Sidebar ---------- */
html#aikm body .app-sidebar{background:var(--x-side) !important;border:0 !important;border-right:1px solid var(--x-side-line) !important;box-shadow:none !important;width:236px !important;border-radius:0 !important;margin:0 !important;}
html#aikm body .app-shell{background:var(--x-bg) !important;gap:0 !important;padding:0 !important;}
html#aikm body .app-main{border-radius:0 !important;margin:0 !important;border:0 !important;box-shadow:none !important;}
html#aikm body .app-sidebar .topbar{background:transparent !important;border:0 !important;border-bottom:1px solid var(--x-side-line) !important;box-shadow:none !important;border-radius:0 !important;margin:0 0 10px !important;padding:22px 20px 18px !important;text-align:left !important;}
html#aikm body .app-sidebar .topbar .logo-wrap{justify-content:flex-start !important;}
html#aikm body .app-sidebar .topbar .logo-wrap span{font-family:var(--x-brand-font) !important;font-size:14.5px !important;font-weight:700 !important;letter-spacing:.06em !important;color:#F3E2A6 !important;text-align:left !important;line-height:1.25 !important;opacity:1 !important;}
html#aikm body .app-sidebar .topbar > span{display:block;margin-top:6px !important;font-size:10.5px !important;letter-spacing:.04em !important;text-transform:none !important;color:#6F7C94 !important;text-align:left !important;opacity:1 !important;}
html#aikm body .app-sidebar .tabbar{background:transparent !important;border:0 !important;box-shadow:none !important;padding:4px 12px !important;gap:2px !important;display:flex;flex-direction:column;}
html#aikm body .app-sidebar .tabbtn{
  background:transparent !important;border:0 !important;box-shadow:none !important;border-radius:8px !important;
  color:var(--x-side-text) !important;font-size:13.5px !important;font-weight:500 !important;letter-spacing:0 !important;text-transform:none !important;
  padding:9px 12px !important;margin:0 !important;min-height:0 !important;height:auto !important;width:100% !important;
  display:flex !important;align-items:center !important;gap:11px !important;text-align:left !important;justify-content:flex-start !important;
  position:relative;transition:background .12s ease,color .12s ease;
}
html#aikm body .app-sidebar .tabbtn:hover{background:rgba(255,255,255,.045) !important;color:#E8ECF3 !important;}
html#aikm body .app-sidebar .tabbtn.active{background:rgba(212,175,55,.10) !important;color:var(--x-side-hi) !important;font-weight:600 !important;}
html#aikm body .app-sidebar .tabbtn.active::before{content:"";position:absolute;left:-12px;top:8px;bottom:8px;width:3px;border-radius:0 3px 3px 0;background:#D4AF37;}
html#aikm body .app-sidebar .tabbtn .tab-ic{font-size:18px !important;width:20px !important;height:20px !important;min-width:20px !important;display:inline-flex !important;align-items:center;justify-content:center;background:none !important;border:0 !important;box-shadow:none !important;border-radius:0 !important;color:inherit !important;opacity:.9;padding:0 !important;margin:0 !important;}
html#aikm body .app-sidebar .tabbtn .tab-ic::after{display:none !important;}
html#aikm body .app-sidebar .tabbtn .rtab-count{margin-left:auto !important;background:rgba(240,120,122,.14) !important;color:#F4A3A4 !important;border:0 !important;font-size:11px !important;font-weight:600 !important;padding:1px 8px !important;border-radius:20px !important;box-shadow:none !important;}
html#aikm body .app-sidebar .backend-access{border-top:1px solid var(--x-side-line) !important;padding:14px 16px !important;gap:6px !important;background:transparent !important;}
html#aikm body .app-sidebar .backend-access a,
html#aikm body .app-sidebar .backend-access button{opacity:1 !important;background:transparent !important;border:1px solid var(--x-side-line) !important;color:var(--x-side-text) !important;border-radius:8px !important;box-shadow:none !important;font-size:12px !important;font-weight:500 !important;letter-spacing:0 !important;text-transform:none !important;padding:7px 10px !important;text-align:center;}
html#aikm body .app-sidebar .backend-access a:hover,
html#aikm body .app-sidebar .backend-access button:hover{background:rgba(255,255,255,.04) !important;color:#E8ECF3 !important;}
html#aikm body .app-sidebar .sync-pill{background:transparent !important;border:1px solid var(--x-side-line) !important;color:var(--x-side-text) !important;border-radius:8px !important;box-shadow:none !important;font-size:11.5px !important;font-weight:500 !important;padding:6px 10px !important;text-align:center;}

/* ---------- Top header ---------- */
html#aikm body .app-main{background:var(--x-bg) !important;}
html#aikm body .app-header{background:var(--x-surface) !important;border:0 !important;border-bottom:1px solid var(--x-line) !important;box-shadow:none !important;min-height:60px;padding:10px 24px !important;gap:12px !important;}
html#aikm body .app-search{background:var(--x-surface-2) !important;border:1px solid var(--x-line) !important;border-radius:10px !important;box-shadow:none !important;max-width:380px;padding:0 12px !important;height:38px;display:flex;align-items:center;gap:8px;}
html#aikm body .app-search input{background:transparent !important;border:0 !important;box-shadow:none !important;color:var(--x-text) !important;font-size:13px !important;padding:0 !important;height:36px !important;outline:0 !important;}
html#aikm body .app-search input::placeholder{color:var(--x-muted) !important;}
html#aikm body .app-search-ic{color:var(--x-muted) !important;}
html#aikm body #headerSyncBar{gap:8px !important;background:transparent !important;border:0 !important;box-shadow:none !important;}
html#aikm body #headerSyncBar .hsb-pill{background:var(--x-surface-2) !important;border:1px solid var(--x-line) !important;color:var(--x-text-2) !important;border-radius:20px !important;font-size:11.5px !important;font-weight:500 !important;padding:5px 11px 5px 22px !important;box-shadow:none !important;position:relative;}
html#aikm body #headerSyncBar .hsb-pill::before{content:"";position:absolute;left:10px;top:50%;width:6px;height:6px;margin-top:-3px;border-radius:50%;background:var(--x-muted);}
html#aikm body #headerSyncBar .hsb-pill.ok::before{background:var(--x-green);}
html#aikm body #headerSyncBar .hsb-pill.err::before{background:var(--x-amber);}
html#aikm body #headerSyncBar .hsb-run{background:transparent !important;border:1px solid var(--x-line) !important;color:var(--x-muted) !important;border-radius:20px !important;width:26px;height:26px;padding:0 !important;font-size:10px !important;box-shadow:none !important;}
html#aikm body #headerSyncBar .hsb-run:hover{color:var(--x-text) !important;border-color:var(--x-line-2) !important;}
html#aikm body .app-theme-toggle{background:var(--x-surface-2) !important;border:1px solid var(--x-line) !important;box-shadow:none !important;}
html#aikm body .app-theme-thumb{background:var(--x-surface) !important;box-shadow:0 1px 2px rgba(0,0,0,.2) !important;color:var(--x-text-2) !important;}

/* ---------- Page header (the bar under the top header) ---------- */
html#aikm body .app-content{background:var(--x-bg) !important;padding:22px 28px 40px !important;}
html#aikm body .subtabbar{background:transparent !important;border:0 !important;box-shadow:none !important;border-radius:0 !important;max-width:none !important;width:auto !important;margin:0 0 18px !important;padding:0 !important;justify-content:flex-start !important;gap:8px !important;align-items:center !important;flex-wrap:wrap;}
html#aikm body .subtabbar .subtab-label{font-family:var(--x-brand-font) !important;font-size:20px !important;font-weight:600 !important;letter-spacing:-.01em !important;text-transform:none !important;color:var(--x-text) !important;margin-right:10px !important;}
html#aikm body .subtabbar > span:not(.subtab-label){font-size:12.5px !important;color:var(--x-muted) !important;}

/* ---------- Cards / panels ---------- */
html#aikm body :is(.panel,.card){background:var(--x-surface) !important;border:1px solid var(--x-line) !important;border-radius:var(--x-radius) !important;box-shadow:var(--x-shadow) !important;backdrop-filter:none !important;-webkit-backdrop-filter:none !important;}
html#aikm body :is(.panel,.card)::before,html#aikm body :is(.panel,.card)::after{display:none !important;}
html#aikm body .panel{padding:18px 20px !important;margin-bottom:16px !important;}
html#aikm body :is(.panel,.card) h2{font-family:var(--x-font) !important;font-size:14.5px !important;font-weight:600 !important;letter-spacing:-.005em !important;text-transform:none !important;color:var(--x-text) !important;justify-content:flex-start !important;text-align:left !important;display:flex;align-items:center;gap:10px;margin-bottom:12px !important;}
html#aikm body :is(.panel,.card) h2 > span:not(.step-num){font-weight:400 !important;}
html#aikm body :is(.step-num,.stepnum){background:var(--x-gold-soft) !important;color:var(--x-gold) !important;border:1px solid var(--x-gold-line) !important;box-shadow:none !important;width:22px !important;height:22px !important;min-width:22px;border-radius:50% !important;font-size:11.5px !important;font-weight:700 !important;display:inline-flex !important;align-items:center;justify-content:center;margin:0 !important;}
html#aikm body :is(.hint,.sub,small.hint){color:var(--x-muted) !important;font-size:12px !important;}
html#aikm body .split{gap:18px !important;}

/* ---------- Form controls ---------- */
html#aikm body :is(input[type="text"],input[type="search"],input[type="number"],input[type="date"],input:not([type]),select,textarea){
  background:var(--x-surface-2) !important;color:var(--x-text) !important;border:1px solid var(--x-line) !important;
  border-radius:var(--x-radius-sm) !important;box-shadow:none !important;font-size:13px !important;
  transition:border-color .12s ease,box-shadow .12s ease;
}
html#aikm body :is(input[type="text"],input[type="search"],input[type="number"],input[type="date"],input:not([type]),select){min-height:36px;padding:0 11px !important;}
html#aikm body textarea{padding:9px 11px !important;line-height:1.5;}
html#aikm body table :is(select,input){min-height:30px;padding:0 6px !important;font-size:12.5px !important;}
html#aikm body :is(input,textarea)::placeholder{color:var(--x-muted) !important;opacity:1;}
html#aikm body :is(input,select,textarea):focus{border-color:var(--x-gold) !important;box-shadow:0 0 0 3px var(--x-gold-soft) !important;outline:0 !important;}
html#aikm body :is(#courierScanInput,#scanInput){min-height:44px !important;font-size:15px !important;font-weight:500;}

/* ---------- Buttons ---------- */
/* base look for every action button (low specificity so the variants below always win) */
html#aikm body :where(.app-content,.admin-modal-box,.modal-box) :where(button:not(.tabbtn,.rtabbtn,.hsb-run,.mini-link,.scan-del-btn,.app-menu-btn,.col-filter-btn),.btn,.chip,.subbtn,label.chip){
  background:var(--x-surface) !important;color:var(--x-text) !important;border:1px solid var(--x-line-2) !important;
  border-radius:var(--x-radius-sm) !important;box-shadow:none !important;text-transform:none !important;letter-spacing:0 !important;
  font-size:12.5px !important;font-weight:600 !important;padding:7px 13px !important;min-height:34px;line-height:1.2;
  transition:background .12s ease,border-color .12s ease,color .12s ease;background-image:none !important;
}
html#aikm body :where(.app-content,.admin-modal-box,.modal-box) :where(button:not(.tabbtn,.rtabbtn,.hsb-run,.mini-link,.scan-del-btn,.app-menu-btn,.col-filter-btn),.btn,.chip,.subbtn):hover{background:var(--x-raise) !important;}
html#aikm body .col-filter-btn{background:transparent !important;border:0 !important;box-shadow:none !important;color:var(--x-muted) !important;padding:0 2px !important;min-height:0 !important;width:auto !important;height:auto !important;font-size:12px !important;opacity:.6;vertical-align:middle;}
html#aikm body .col-filter-btn:hover,html#aikm body .col-filter-btn.active{opacity:1;color:var(--x-gold) !important;}
/* primary actions */
html#aikm body .app-content :is(#downloadBtn,#bulkBtn,.btn-gold,button.gold,.btn:not(.btn-ghost):not(.btn-small)),
html#aikm body .admin-modal-btn:not(.ghost):not(.secondary){background:var(--x-primary) !important;color:var(--x-primary-ink) !important;border-color:var(--x-primary) !important;}
html#aikm body .app-content :is(#downloadBtn,#bulkBtn,.btn-gold,button.gold):hover{filter:brightness(1.06);}
/* danger */
html#aikm body .app-content :is(button.danger,.subbtn-danger,.sd-danger){color:var(--x-red) !important;border-color:color-mix(in srgb,var(--x-red) 35%,transparent) !important;background:transparent !important;}
html#aikm body .app-content :is(button.danger,.subbtn-danger,.sd-danger):hover{background:var(--x-red-soft) !important;}
html#aikm body .app-content :is(.btn-ghost,button.ghost,button.secondary){background:transparent !important;}
html#aikm body .app-content button:disabled{opacity:.45 !important;cursor:not-allowed;}
html#aikm body .mini-link{color:var(--x-gold) !important;background:none !important;border:0 !important;font-weight:600 !important;}
html#aikm body .scan-del-btn{background:transparent !important;border:1px solid var(--x-line) !important;color:var(--x-muted) !important;border-radius:6px !important;box-shadow:none !important;}
html#aikm body .scan-del-btn:hover{color:var(--x-red) !important;border-color:var(--x-red) !important;background:var(--x-red-soft) !important;}

/* ---------- Segmented tabs inside panels ---------- */
html#aikm body .rtabbar{background:var(--x-surface-2) !important;border:1px solid var(--x-line) !important;border-radius:10px !important;padding:4px !important;gap:2px !important;box-shadow:none !important;display:flex;flex-wrap:wrap;margin-bottom:14px !important;}
html#aikm body .rtabbtn{background:transparent !important;border:0 !important;box-shadow:none !important;border-radius:7px !important;color:var(--x-muted) !important;font-size:12.5px !important;font-weight:600 !important;letter-spacing:0 !important;text-transform:none !important;padding:7px 12px !important;min-height:0 !important;line-height:1.3 !important;display:inline-flex;align-items:center;gap:6px;}
html#aikm body .rtabbtn:hover{color:var(--x-text) !important;background:rgba(127,127,127,.06) !important;}
html#aikm body .rtabbtn.active{background:var(--x-surface) !important;color:var(--x-text) !important;box-shadow:0 1px 2px rgba(0,0,0,.18),0 0 0 1px var(--x-line) !important;}
html#aikm body .rtabbtn .rtab-count{background:var(--x-raise) !important;color:var(--x-text-2) !important;border:0 !important;border-radius:20px !important;font-size:11px !important;font-weight:600 !important;padding:1px 7px !important;box-shadow:none !important;}
html#aikm body .rtabbtn.active .rtab-count{background:var(--x-gold-soft) !important;color:var(--x-gold) !important;}
html#aikm body .om-nav-inline{background:transparent !important;border:0 !important;box-shadow:none !important;justify-content:flex-start !important;padding:0 !important;max-width:none !important;}
html#aikm body .om-nav-inline .subbtn.active{background:var(--x-gold-soft) !important;border-color:var(--x-gold-line) !important;color:var(--x-gold) !important;}

/* ---------- Data tables ---------- */
html#aikm body .table-scroll{border:1px solid var(--x-line) !important;border-radius:10px !important;background:var(--x-surface) !important;box-shadow:none !important;}
html#aikm body table.data{background:transparent !important;border:0 !important;border-collapse:separate !important;border-spacing:0 !important;width:100%;font-size:12.75px !important;box-shadow:none !important;border-radius:0 !important;}
html#aikm body table.data thead th{position:sticky;top:0;z-index:2;background:var(--x-surface-2) !important;color:var(--x-muted) !important;font-size:11px !important;font-weight:600 !important;letter-spacing:.04em !important;text-transform:uppercase !important;text-align:left;padding:10px 12px !important;border:0 !important;border-bottom:1px solid var(--x-line) !important;box-shadow:none !important;white-space:nowrap;}
html#aikm body table.data tbody td{background:transparent !important;color:var(--x-text) !important;padding:9px 12px !important;border:0 !important;border-bottom:1px solid var(--x-line) !important;vertical-align:middle;line-height:1.4;}
html#aikm body table.data tbody tr:last-child td{border-bottom:0 !important;}
html#aikm body table.data tbody tr{background:transparent !important;transition:none !important;}
html#aikm body table.data tbody tr:hover td{background:var(--x-raise) !important;}
html#aikm body table.data tbody tr.loss-row td{background:color-mix(in srgb,var(--x-red-soft) 60%,transparent) !important;}
html#aikm body table.data tbody tr.loss-row:hover td{background:var(--x-red-soft) !important;}
html#aikm body table.data td.empty,html#aikm body .empty{color:var(--x-muted) !important;}
html#aikm body :is(.col-filter-mini,th .ti-filter){opacity:.55;}
html#aikm body th:hover :is(.col-filter-mini){opacity:1;}

/* ---------- Chips, badges, pills ---------- */
html#aikm body :is(.badge,.pill,.channel-badge,.loss-badge){border-radius:20px !important;font-size:11px !important;font-weight:600 !important;padding:2px 9px !important;box-shadow:none !important;border:1px solid var(--x-line) !important;background:var(--x-surface-2) !important;color:var(--x-text-2) !important;white-space:nowrap;letter-spacing:0 !important;text-transform:none !important;}
html#aikm body :is(.badge.green,.pill.green){background:var(--x-green-soft) !important;color:var(--x-green) !important;border-color:transparent !important;}
html#aikm body :is(.badge.red,.pill.red,.loss-badge){background:var(--x-red-soft) !important;color:var(--x-red) !important;border-color:transparent !important;}
html#aikm body :is(.badge.amber,.badge-amber,.pill.amber){background:var(--x-amber-soft) !important;color:var(--x-amber) !important;border-color:transparent !important;}
html#aikm body :is(.badge.blue,.pill.blue){background:var(--x-blue-soft) !important;color:var(--x-blue) !important;border-color:transparent !important;}
html#aikm body :is(.badge.gold,.pill.gold){background:var(--x-gold-soft) !important;color:var(--x-gold) !important;border-color:transparent !important;}
html#aikm body .chip-row{gap:8px !important;}

/* ---------- Scan result box ---------- */
html#aikm body .result{background:var(--x-surface-2) !important;border:1px dashed var(--x-line-2) !important;border-radius:10px !important;box-shadow:none !important;color:var(--x-text) !important;margin-top:12px !important;}
html#aikm body .result.empty{color:var(--x-muted) !important;}

/* ---------- Stat blocks ---------- */
html#aikm body :is(.stat,.bstat){background:var(--x-surface) !important;border:1px solid var(--x-line) !important;border-radius:var(--x-radius) !important;box-shadow:var(--x-shadow) !important;}
html#aikm body :is(.stat-num,.bnum){color:var(--x-text) !important;font-weight:700 !important;}
html#aikm body :is(.stat-label,.blabel){color:var(--x-muted) !important;text-transform:none !important;letter-spacing:0 !important;}

/* ---------- Modals & popups ---------- */
html#aikm body :is(.admin-modal-overlay,.modal-overlay){background:rgba(6,10,20,.55) !important;backdrop-filter:none !important;-webkit-backdrop-filter:none !important;}
html#aikm body :is(.admin-modal-box,.modal-box){background:var(--x-surface) !important;border:1px solid var(--x-line) !important;border-radius:14px !important;box-shadow:0 20px 50px rgba(0,0,0,.35) !important;color:var(--x-text) !important;}
html#aikm body .admin-modal-glow{display:none !important;}
html#aikm body .admin-modal-kicker{color:var(--x-gold) !important;letter-spacing:.06em !important;}
html#aikm body :is(#columnFilterPopup,.col-filter-popup){background:var(--x-surface) !important;border:1px solid var(--x-line) !important;border-radius:10px !important;box-shadow:0 12px 30px rgba(0,0,0,.25) !important;color:var(--x-text) !important;}
html#aikm body #globalBusyOverlay{background:rgba(6,10,20,.35) !important;}
html#aikm body #globalBusyOverlay .gbo-card{background:var(--x-surface) !important;border:1px solid var(--x-line) !important;}
html#aikm body #globalBusyOverlay .gbo-label{color:var(--x-text) !important;}

/* ---------- Pagers ---------- */
html#aikm body [id$="Pager"] span{color:var(--x-muted) !important;}

/* ---------- Manifest handover sheets: keep a clean paper look on screen ---------- */
html#aikm body #manifest > *{border-radius:var(--x-radius) !important;box-shadow:var(--x-shadow) !important;border:1px solid var(--x-line) !important;}

html#aikm body #manifest button{background:#FFFFFF !important;color:#0F1E35 !important;border:1px solid #D8D3C6 !important;opacity:1 !important;}
html#aikm body #manifest button:hover{background:#F3F1EB !important;}


/* ---------- Amazon Self-Ship (uses its own colour set — mapped onto the new palette) ---------- */
html#aikm body #tab-selfship{--fs-card:var(--x-surface);--fs-card-alt:var(--x-surface-2);--fs-page:transparent;--fs-shadow:var(--x-shadow);--fs-text:var(--x-text);--fs-text2:var(--x-text-2);--fs-text3:var(--x-muted);--fs-line:var(--x-line);--fs-line-strong:var(--x-line-2);--fs-badge-bg:var(--x-gold-soft);--fs-badge-text:var(--x-gold);--fs-success-bg:var(--x-green-soft);--fs-success-text:var(--x-green);--fs-danger-bg:var(--x-red-soft);--fs-danger-text:var(--x-red);--fs-pill-bg:var(--x-surface);--fs-pill-text:var(--x-text);}
html#aikm body #tab-selfship > .wrap{background:transparent !important;max-width:900px !important;margin:0 auto !important;padding:0 !important;border:0 !important;box-shadow:none !important;}
html#aikm body #tab-selfship .card > div:first-child:not(.rule-title){background:var(--x-surface-2) !important;border:1px solid var(--x-line) !important;box-shadow:none !important;}
html#aikm body #tab-selfship .upload-row{display:block !important;}
html#aikm body #tab-selfship .upload-row > .card{width:auto !important;max-width:none !important;}
html#aikm body #tab-selfship :is(.step-note,.rt-label){color:var(--x-muted) !important;}
html#aikm body #tab-selfship .rt-label{color:var(--x-gold) !important;}
html#aikm body #tab-selfship :is(#fsTabGenerate,#fsTabFakeShip){border-radius:20px !important;}
