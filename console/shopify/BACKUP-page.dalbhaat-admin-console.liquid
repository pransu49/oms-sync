          doc.setFont(FONT, "bold"); doc.setFontSize(8.5); doc.setTextColor.apply(doc, NAVY); doc.text(nm, c.x + 2, y0, { lineHeightFactor: 1.25 });
          doc.setFont(FONT, "normal"); doc.setFontSize(7); doc.setTextColor.apply(doc, MUTED); doc.text(sb, c.x + 2, y0 + nm.length * 3.7 + 0.4, { lineHeightFactor: 1.25 });
        }
        if (h.column.index === 7) { doc.setDrawColor.apply(doc, NAVY); doc.setLineWidth(0.35); doc.roundedRect(c.x + (c.width - 6) / 2, c.y + (c.height - 6) / 2, 6, 6, 1, 1, "S"); }
      }
    });
    // totals row
    var y = doc.lastAutoTable.finalY + 6;
    if (y > 270) { doc.addPage(); y = 20; }
    doc.setFont(FONT, "bold"); doc.setFontSize(10); doc.setTextColor.apply(doc, NAVY);
    doc.text("Total: " + rows.length + " products  ·  " + units.toLocaleString("en-IN") + " units  ·  " + inr(value, R), 200, y, { align: "right" });
    doc.setFont(FONT, "normal"); doc.setFontSize(8); doc.setTextColor.apply(doc, MUTED);
    doc.text("Picked by: ____________________     Checked by: ____________________", 10, y + 10);
    // page footer
    var pages = doc.getNumberOfPages();
    for (var i = 1; i <= pages; i++) {
      doc.setPage(i); doc.setFont(FONT, "normal"); doc.setFontSize(7.5); doc.setTextColor.apply(doc, MUTED);
      doc.text("AIKM PHARMA PRIVATE LIMITED  ·  LOTS picking list  ·  " + whenTxt, 10, 290);
      doc.text("Page " + i + " of " + pages, 200, 290, { align: "right" });
    }
    doc.save("LOTS_Picking_List_" + when.toISOString().slice(0, 10) + ".pdf");
  }

  // ---------- buttons + panel ----------
  var latestId = null, myReq = null, autoDone = {};
  function esc(v) { return String(v == null ? "" : v).replace(/[&<>"']/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]; }); }
  function pdfButton(row) {
    var b = document.createElement("button");
    b.type = "button"; b.className = "lc-pdf"; b.textContent = "📄 Picking List PDF";
    b.title = "Products in your LOTS cart with image, qty, price and coupon — grouped by category, sorted by brand";
    b.addEventListener("click", function () { makePdf(latest, b); });
    row.insertBefore(b, row.children[1] || null);
    return b;
  }
  // panel for a "read my LOTS cart" request (the push panel shows it otherwise as an upload)
  function renderRead(panel) {
    var d = latest, key = latestId + ":" + d.status + ":" + (d.progress || "");
    if (panel.dataset.lxKey === key && panel.querySelector(".lc-own")) return;
    panel.dataset.lxKey = key;
    panel.style.display = "block";
    var html;
    if (d.status === "pending" || d.status === "processing") {
      html = '<div class="lc-own lc-head"><span class="lc-dot wait"></span>Reading the products in your LOTS cart…</div>' +
        '<div class="lc-sub">' + esc(d.status === "processing" ? d.progress || "Robot is logging into LOTS…" : "Waiting for the robot — starts automatically within 5–15 minutes.") + " Nothing in your cart is changed.</div>";
    } else if (d.status === "failed") {
      html = '<div class="lc-own lc-head"><span class="lc-dot bad"></span>Could not read your LOTS cart</div><div class="lc-sub">' + esc(d.error || "Unknown error") + "</div>" +
        '<div class="lc-actions"><button type="button" data-lx="again">↻ Try again</button><button type="button" data-lx="hide">Hide</button></div>';
    } else {
      var lines = d.cartLines || [], u = lines.reduce(function (t, x) { return t + (Number(x.qty) || 0); }, 0);
      var at = new Date(d.cartReadAtMs || d.createdAtMs || Date.now()).toLocaleString("en-IN", { day: "numeric", month: "short", hour: "2-digit", minute: "2-digit" });
      html = '<div class="lc-own lc-head"><span class="lc-dot ' + (lines.length ? "ok" : "bad") + '"></span>' + (lines.length ? "Your LOTS cart has " + lines.length + " products · " + u + " units" : "Your LOTS cart is empty") + "</div>" +
        '<div class="lc-sub">Read from LOTS at ' + at + "</div>" +
        '<div class="lc-actions"><a class="gold" href="https://www.lotswholesale.com/member/cart" target="_blank" rel="noopener">Open LOTS cart</a><button type="button" data-lx="hide">Hide</button></div>';
    }
    panel.innerHTML = html;
    if (d.status === "done" && (d.cartLines || []).length) pdfButton(panel.querySelector(".lc-actions"));
  }
  function addButton() {
    var panel = document.getElementById("lotsCartPanel");
    if (!panel || !latest) return;
    if (latest.type === "readCart") return renderRead(panel);
    panel.dataset.lxKey = "";
    if (latest.status !== "done" || panel.querySelector(".lc-pdf")) return;
    var row = panel.querySelector(".lc-actions");
    if (!row) { row = document.createElement("div"); row.className = "lc-actions"; panel.appendChild(row); }
    pdfButton(row);
  }
  function requestRead() {
    if (latest && (latest.status === "pending" || latest.status === "processing"))
      return void alert("The LOTS robot is busy with another request — wait for it to finish, then try again.");
    if (!confirm("Make a picking-list PDF of the products already in your LOTS cart?\n\n• The robot reads your LOTS cart — nothing is added, removed or ordered\n• Takes about 5–15 minutes\n• The PDF downloads automatically on this computer when ready")) return;
    var b = document.getElementById("lotsCartPdfBtn"); if (b) b.disabled = true;
    fbDb.collection(QUEUE).add({ status: "pending", type: "readCart", vendor: "LOTS", items: [], sentCount: 0, createdAtMs: Date.now(), createdAt: firebase.firestore.FieldValue.serverTimestamp() })
      .then(function (ref) { myReq = ref.id; })
      .catch(function (e) { alert("Could not send the request: " + (e.message || e)); })
      .then(function () { if (b) b.disabled = false; });
  }
  (function watch() {
    var panel = document.getElementById("lotsCartPanel"), push = document.getElementById("lotsCartBtn");
    if (typeof fbDb === "undefined" || !fbDb || !panel || !push) return void setTimeout(watch, 2000);
    var rb = document.createElement("button");
    rb.type = "button"; rb.id = "lotsCartPdfBtn"; rb.className = push.className.replace(/\bgold\b/, "");
    rb.textContent = "📄 LOTS Cart PDF";
    rb.title = "Picking-list PDF of the products already in your LOTS cart (image, qty, price, coupon)";
    rb.addEventListener("click", requestRead);
    push.after(rb);
    panel.addEventListener("click", function (e) {
      var a = e.target.closest("[data-lx]"); if (!a) return;
      if (a.dataset.lx === "hide") panel.style.display = "none";
      if (a.dataset.lx === "again") requestRead();
    });
    new MutationObserver(addButton).observe(panel, { childList: true });
    fbDb.collection(QUEUE).orderBy("createdAtMs", "desc").limit(1).onSnapshot(function (snap) {
      latest = snap.empty ? null : snap.docs[0].data();
      latestId = snap.empty ? null : snap.docs[0].id;
      setTimeout(addButton, 50);
      // the PDF downloads by itself when this computer asked for it
      if (latest && latestId === myReq && latest.status === "done" && !autoDone[latestId] && (latest.cartLines || []).length) {
        autoDone[latestId] = true;
        setTimeout(function () { var b = document.querySelector("#lotsCartPanel .lc-pdf"); if (b) makePdf(latest, b); }, 400);
      }
    }, function (e) { console.warn("Picking list: cart status error", e); });
  })();
  window.__lotsPickPdfTest = function (d) { latest = d; addButton(); };
});
</script>
