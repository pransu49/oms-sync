</style>
<script>
document.addEventListener("DOMContentLoaded", function () {
  if (typeof renderLotsRow !== "function" || typeof lotsVendor === "undefined") return;

  // 1) Fresh synced data always wins over the old copy saved in this browser
  var origRenderLotsRow = renderLotsRow;
  renderLotsRow = function () {
    var fresh = lotsVendor.products, freshPrepped = lotsVendor.prepped;
    origRenderLotsRow.apply(this, arguments);
    if (fresh && fresh.length && lotsVendor.products !== fresh) {
      lotsVendor.products = fresh;
      lotsVendor.prepped = freshPrepped;
      try { localStorage.removeItem(VENDOR_STORE_KEY); } catch (e) {}
      if (typeof rebuildAllPrepped === "function") rebuildAllPrepped();
      var btn = document.getElementById("lotsFileBtn");
      if (btn) btn.textContent = "✅ Auto-synced from LOTS Wholesale — " + fresh.length + " products";
    }
    var tab = document.getElementById("tab-lotsproducts");
    if (tab && tab.classList.contains("active") && typeof renderLotsProductsTable === "function") renderLotsProductsTable();
  };

  // 2) Helpers
  var DAY = 24 * 60 * 60 * 1000;
  function esc(v) { return escapeHtml(v == null ? "" : String(v)); }
  function inr(n) { return "₹" + Number(n).toLocaleString("en-IN", { maximumFractionDigits: 2 }); }
  function sortedSlabs(p) { return (p.slabs || []).slice().sort(function (a, b) { return a.min - b.min; }); }
  function bestPrice(p) { var s = p.slabs || []; return s.length ? Math.min.apply(null, s.map(function (x) { return x.price; })) : null; }
  function rangeTxt(s) { return (s.max === 1 / 0 || s.max === null) ? s.min + "+" : (s.min === s.max ? String(s.min) : s.min + "–" + s.max); }
  function isOos(p) { return !p.removedAt && p.qty != null && Number(p.qty) <= 0; }
  var WEEK = 7 * DAY;
  function isNew(p) { return !!p.addedAt && Date.now() - new Date(p.addedAt).getTime() <= WEEK; }
  function shortDate(iso) { try { return new Date(iso).toLocaleDateString("en-IN", { day: "numeric", month: "short" }); } catch (e) { return ""; } }
  function tagHtml(p) {
    if (p.removedAt) return '<span class="lx-tag rem">Removed ' + shortDate(p.removedAt) + "</span>";
    if (isNew(p)) return '<span class="lx-tag new">New ' + shortDate(p.addedAt) + "</span>";
    return "";
  }
  var removedItems = [];
  // stock alert from the sync: went out of stock / back in stock / changed by 50+ (shown for 24 hours)
  function stockAlert(p) {
    var e = p.stockEvent;
    if (!e || !e.at || Date.now() - new Date(e.at).getTime() > DAY) return null;
    return e;
  }
  function saBadge(p) {
    var e = stockAlert(p); if (!e) return "";
    var f = Number(e.from).toLocaleString("en-IN"), t = Number(e.to).toLocaleString("en-IN"), d = Math.abs(Number(e.to) - Number(e.from)).toLocaleString("en-IN");
    var txt = e.type === "oos" ? "\u26A0 Went out of stock (was " + f + ")"
      : e.type === "back" ? "\u2713 Back in stock (" + t + " units)"
      : e.type === "up" ? "\u25B2 Stock +" + d + " (" + f + " \u2192 " + t + ")"
      : "\u25BC Stock \u2212" + d + " (" + f + " \u2192 " + t + ")";
    return '<span class="lx-sa ' + e.type + '">' + txt + "</span>";
  }
  // Amazon mappings made on the Amazon (SP-API) page: ASIN -> LOTS item(s), saved in aikm_admin/spapiAsinLotsMap
  var AMZ_ACCTS = { praso: "Praso", sastastore: "Sasta Store" };
  var amzMap = {}, amzInv = {}, amzIdx = null; // amzInv: ASIN -> [{acct, sku, name, qty, price}]
  function amzIndex() {
    if (amzIdx) return amzIdx;
    amzIdx = {};
    Object.keys(amzMap).forEach(function (asin) {
      var r = amzMap[asin]; if (!r) return;
      if (r.vendorName && String(r.vendorName).toUpperCase() !== "LOTS") return;
      var parts = Array.isArray(r.parts) && r.parts.length ? r.parts : (r.code ? [{ code: r.code, qty: 1 }] : []);
      parts.forEach(function (x) {
        if (!x || !x.code) return;
        var c = String(x.code);
        (amzIdx[c] = amzIdx[c] || []).push({ asin: asin, pack: Math.max(1, +x.qty || 1), lp: Math.max(1, parseInt(x.lotsPack) || 1), combo: parts.length > 1, list: amzInv[asin] || [] });
      });
    });
    return amzIdx;
  }
  function amzFor(p) { return amzIndex()[String(p.code)] || null; }
  function amzTitle(a) { var l = a.list.filter(function (x) { return x.name; })[0]; return l ? l.name : "ASIN " + a.asin; }
  function packTxt(a) { return a.combo ? "Combo" : a.lp > 1 ? a.pack + " of " + a.lp + "-pack" : a.pack > 1 ? "Pack of " + a.pack : "Single"; }
  function mapTag(p) {
    var a = amzFor(p); if (!a) return "";
    return '<span class="lx-tag amz" data-lxtip="' + esc(String(p.code)) + '">\u2713 Amazon' + (a.length > 1 ? " \u00D7" + a.length : "") + "</span>";
  }
  function amzLine(p) {
    var a = amzFor(p); if (!a) return "";
    var chips = [];
    a.forEach(function (x) {
      if (!x.list.length) chips.push('<span class="lx-ch amz">' + packTxt(x) + " · " + esc(x.asin) + "</span>");
      x.list.forEach(function (l) {
        chips.push('<span class="lx-ch amz">' + esc(AMZ_ACCTS[l.acct] || l.acct) + (l.price != null ? " · " + inr(l.price) : "") + (x.pack > 1 || x.lp > 1 || x.combo ? " · " + packTxt(x) : "") + "</span>");
      });
    });
    return '<div data-lxtip="' + esc(String(p.code)) + '"><div class="lx-ours amz">↳ Amazon · ' + esc(amzTitle(a[0])) + (a.length > 1 ? " +" + (a.length - 1) + " more" : "") +
      '</div><div class="lx-chs">' + chips.join("") + "</div></div>";
  }
  function oursLine(p) { return amzLine(p); }
  function tipHtml(p) {
    var a = amzFor(p), am = "";
    if (a) am = '<div class="tt-k amz">On Amazon \u00B7 ' + a.length + " listing" + (a.length > 1 ? "s" : "") + "</div>" +
      a.map(function (x) {
        return '<div class="tt-p"><div class="tt-n">' + esc(amzTitle(x)) + '</div><div class="tt-none">ASIN ' + esc(x.asin) + " \u00B7 " + packTxt(x) + (x.lp > 1 && !x.combo ? " (" + x.pack + " of " + x.lp + " pcs per order \u2014 1 LOTS unit = " + Math.round(x.lp / x.pack * 100) / 100 + " orders)" : x.pack > 1 && !x.combo ? " (" + x.pack + " LOTS units per order)" : "") + "</div>" +
          (x.list.length ? '<div class="tt-c">' + x.list.map(function (l) { return "<span>" + esc(AMZ_ACCTS[l.acct] || l.acct) + (l.price != null ? "<b>" + inr(l.price) + "</b>" : "") + (l.qty != null ? " \u00B7 stock <b>" + l.qty + "</b>" : "") + "</span>"; }).join("") + "</div>" : '<div class="tt-none">Listing details load with the next Amazon sync</div>') + "</div>";
      }).join("") + '<div class="tt-f">Mapped on the Amazon page \u00B7 price &amp; stock from SP-API</div>';
    return am;
  }
  // price change in the last 24 hours: "up" | "down" | null
  function priceMove(p) {
    if (p.prevPrice == null || !p.priceChangedAt) return null;
    if (Date.now() - new Date(p.priceChangedAt).getTime() > DAY) return null;
    var now = bestPrice(p);
    if (now == null || now === p.prevPrice) return null;
    return now > p.prevPrice ? "up" : "down";
  }
  function pcBadge(p) {
    var m = priceMove(p); if (!m) return "";
    var diff = Math.abs(bestPrice(p) - p.prevPrice);
    return '<span class="lx-pc ' + m + '" title="Was ' + inr(p.prevPrice) + '">' + (m === "up" ? "▲ " : "▼ ") + inr(Math.round(diff * 100) / 100) + " <s>" + inr(p.prevPrice) + "</s></span>";
  }
  function stockPill(p, long) {
    if (p.removedAt) return tagHtml(p);
    if (p.qty == null) return "";
    if (isOos(p)) return '<span class="lx-stock out">OUT OF STOCK</span>';
    return '<span class="lx-stock ' + (p.qty < 10 ? "low" : "ok") + '">' + Number(p.qty).toLocaleString("en-IN") + (long ? " in stock" : "") + "</span>";
  }
  function slabsHtml(p) {
    var slabs = sortedSlabs(p); if (!slabs.length) return "—";
    var best = bestPrice(p);
    return '<div class="lx-slabs">' + slabs.map(function (s) {
      return '<span class="lx-slab' + (s.price === best && slabs.length > 1 ? " best" : "") + '"><b>' + inr(s.price) + "</b><i>" + rangeTxt(s) + "</i></span>";
    }).join("") + "</div>";
  }
  function imgBox(p, cls) {
    if (!p.img) return '<div class="lx-img none ' + cls + '"><i class="ti ti-photo-off"></i></div>';
    return '<div class="lx-img ' + cls + '" data-zoom="' + esc(p.img) + '"><img loading="lazy" src="' + esc(p.img) + '" alt="" onerror="lxImgFail(this)"></div>';
  }
  window.lxImgFail = function (img) {
    var b = img.parentNode; if (!b) return;
    b.classList.add("none"); b.removeAttribute("data-zoom");
    b.innerHTML = '<i class="ti ti-photo-off"></i>';
  };
  function saveTxt(p) {
    var b = bestPrice(p); if (!p.mrp || !b) return "";
    var s = Math.round((1 - b / p.mrp) * 1000) / 10;
    return s > 0 ? '<span class="lx-save">' + s + "% off</span>" : "";
  }

  // 3) Table row
  function rowHtml(p) {
    return '<td><div class="lx-pcell">' + imgBox(p, "lx-thumb") + '<div><div class="lx-name">' + esc(p.name) + '</div><div class="lx-sub">' + (p.brand ? '<span class="lx-brand">' + esc(p.brand) + "</span>" : "") + "<span>#" + esc(p.code) + "</span>" + mapTag(p) + (isNew(p) && !p.removedAt ? tagHtml(p) : "") + "</div>" + oursLine(p) + "</div></div></td>" +
      '<td><div class="lx-mono">' + esc(p.barcode || "—") + '</div><div class="lx-sub">HSN ' + esc(p.hsn || "—") + "</div></td>" +
      "<td>" + (p.gst != null ? '<span class="lx-gst">' + p.gst + "%</span>" : "—") + "</td>" +
      "<td>" + (stockPill(p, false) || "—") + (stockAlert(p) ? '<div style="margin-top:4px;">' + saBadge(p) + "</div>" : "") + "</td>" +
      "<td>" + slabsHtml(p) + (priceMove(p) ? '<div style="margin-top:4px;">' + pcBadge(p) + "</div>" : "") + "</td>" +
      "<td>" + (p.mrp ? '<div class="lx-mrp">' + inr(p.mrp) + "</div>" + saveTxt(p) : "—") + "</td>";
  }

  // 4) Card: everything visible — brand, stock, image, name, tags, all slab prices in one line, MRP, Amazon mapping, codes
  function cardHtml(p) {
    var slabs = sortedSlabs(p), best = bestPrice(p), move = priceMove(p);
    function pcs(x) { var r = rangeTxt(x); return r + (r === "1" ? " pc" : " pcs"); }
