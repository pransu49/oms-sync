      html#aikm body .aikm-pr .lbl small{color:var(--x-muted,#8B93A3);font-size:11px;}
      html#aikm body .aikm-pr .aikm-n{color:var(--x-text,#0F1E35);}
      html#aikm body .aikm-pr .go{font-size:13px;color:var(--x-muted,#B5BBC6);opacity:0;transition:opacity .12s;}
      html#aikm body .aikm-pr:hover .go{opacity:1;}
      html#aikm body .aikm-pe{padding:26px 16px;text-align:center;font-size:12.5px;color:var(--x-muted,#8B93A3);}
      html#aikm body .aikm-pe .ti{display:block;font-size:24px;color:var(--x-green,#1F7A4D);margin-bottom:6px;}
      html#aikm body .aikm-pf{padding:10px 16px 12px;font-size:10.5px;color:var(--x-muted,#8B93A3);border-top:1px solid var(--x-line,#F5F2EA);}
      @media (max-width:1500px){ html#aikm body .aikm-fb small{display:none;} }
      @media (max-width:900px){
        html#aikm body .app-header{flex-wrap:nowrap !important;height:auto !important;min-height:62px !important;}
        html#aikm body .app-header .aikm-ops{height:62px;flex:1 1 0 !important;min-width:0;order:1;}
        html#aikm body .app-header .app-menu-btn{order:0;}
        html#aikm body .app-header .app-theme-toggle{order:2;}
        html#aikm body .aikm-lanes,html#aikm body .aikm-fb,html#aikm body .aikm-hsub,html#aikm body #aikmSyTxt{display:none;}
        html#aikm body .aikm-health{gap:9px;padding-right:0;border-right:0;height:auto;}
        html#aikm body .aikm-ring,html#aikm body .aikm-ring svg{width:40px;height:40px;}
        html#aikm body .aikm-score{font-size:14px;}
        html#aikm body .aikm-hstate{font-size:15px;}
        html#aikm body .aikm-status{margin-left:auto;}
        html#aikm body .app-header button.aikm-st{padding:0 11px !important;}
        html#aikm body #aikmAllTxt .lg{display:none;}
        html#aikm body #aikmAllTxt .sm{display:inline;}
        html#aikm body .aikm-allwrap{padding-left:8px;}
        html#aikm body .app-header button.aikm-all{padding:0 12px !important;}
        html#aikm body #aikmPanel{left:12px;right:12px;width:auto;top:66px;}
      }
    </style>
    <script>
    (function(){
      var $=function(id){return document.getElementById(id);};
      var PEND=/^(new|ready to ship|packed|pending)$/i, CANC=/cancel/i, DAY=864e5;
      var handover={list:[],at:0,loading:false}, amazon=null, amazonUnsub=null, easy=null, easyUnsub=null, lastA=[], fbUse=null, fbAt=0, fbLoading=false;
      /* critical = must act today; everything else = watch */
      var CRIT={fbover:1,sla:1,cancelbatch:1,cancelreq:1,handover:1,esrobot:1,esfail:1,syncbad:1};
      var VERB={fbover:"Cut",sla:"Ship",cancelbatch:"Remove",cancelreq:"Hold",handover:"Check",esrobot:"Restart",esfail:"Fix",escheck:"Check",ndr:"Call",late:"Chase",pickuplate:"Chase",loss:"Review",buybox:"Win back",notselling:"Relist",amzoos:"Restock",amzdup:"Merge",amztax:"Fix",lotsprice:"Review",lotsoos:"Replace",returns:"Expect",stale:"Check",syncbad:"Check"};
      var CSHORT={sla:"past SLA",cancelreq:"cancel requests",esfail:"Easy Ship failed",cancelbatch:"cancelled in pickup batch",handover:"handed over, not shipped",esrobot:"Easy Ship robot failed"};
      var WSHORT={ndr:"NDR",late:"late delivery",pickuplate:"late pickup",loss:"loss · 7d",buybox:"buy box lost",notselling:"not selling",amzoos:"Amazon OOS",amzdup:"duplicates",amztax:"tax / HSN",lotsprice:"LOTS price",lotsoos:"LOTS OOS",returns:"returns",escheck:"Easy Ship check",stale:"OMS stale",fbnear:"Firebase high"};
      var SHORT={fbover:"Firebase use",sla:"past SLA",cancelbatch:"cancelled in batch",cancelreq:"cancels",handover:"handovers",esrobot:"Easy Ship robot",esfail:"Easy Ship",escheck:"Easy Ship",ndr:"NDR buyers",late:"late deliveries",pickuplate:"late pickups",loss:"loss orders",buybox:"buy box",notselling:"listings",amzoos:"Amazon stock",amzdup:"duplicates",amztax:"tax / HSN",lotsprice:"LOTS prices",lotsoos:"LOTS items",returns:"returns",stale:"OMS sync",syncbad:"syncs"};
      function esc(s){return String(s==null?"":s).replace(/[&<>"]/g,function(c){return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c];});}
      function fmt(n){return Number(n||0).toLocaleString("en-IN");}
      function ago(ms){var m=Math.max(0,Math.round((Date.now()-ms)/60000));return m<60?m+" min":m<1440?Math.floor(m/60)+" hr":Math.floor(m/1440)+" day";}
      function dayStart(d){return new Date(d.getFullYear(),d.getMonth(),d.getDate()).getTime();}
      function go(tab){var b=document.querySelector('#mainTabbar .tabbtn[data-tab="'+tab+'"]');if(b)b.click();}
      function awbMaps(o){var exact={},tail={};for(var i=0;i<o.length;i++){var a=(o[i].awb||"").trim();if(!a)continue;exact[a]=o[i];var dg=a.replace(/\D/g,"");if(dg.length>=8)tail[dg.slice(-8)]=o[i];}return {exact:exact,tail:tail};}
      function findAwb(m,awb){awb=String(awb||"").trim();var dg=awb.replace(/\D/g,"");return m.exact[awb]||(dg.length>=8?m.tail[dg.slice(-8)]:null);}

      /* ---- data loaders (cheap: one small query per hour, live listeners on 2 small docs) ---- */
      function loadHandover(){
        if(handover.loading||typeof fbDb==="undefined"||!fbDb)return;
        if(handover.at&&Date.now()-handover.at<60*60000)return;
        handover.loading=true;
        fbDb.collection("aikm_admin").doc("data").collection("manifestHistory")
          .where("closedAt",">=",Date.now()-7*DAY).get()
          .then(function(snap){
            var list=[];snap.forEach(function(d){var r=d.data()||{};(r.awbs||[]).forEach(function(a){if(a&&a.awb)list.push({awb:String(a.awb).trim(),courier:a.courier||"",at:r.closedAt||a.at||0});});});
            handover.list=list;handover.at=Date.now();handover.loading=false;render();
          }).catch(function(e){handover.loading=false;handover.at=Date.now();console.warn("Header: handover check failed",e);});
      }
      function watchAmazon(){
        if(amazonUnsub||typeof fbDb==="undefined"||!fbDb)return;
        amazonUnsub=fbDb.collection("aikm_admin").doc("headerAlerts").onSnapshot(function(d){amazon=d.exists?(d.data().amazon||{}):{};render();},function(e){console.warn("Header: Amazon alerts unavailable",e);});
      }
      function watchEasyShip(){
        if(easyUnsub||typeof firebase==="undefined"||!firebase.apps)return;
        var app=firebase.apps.filter(function(a){return a.options&&a.options.projectId==="aikm-oms-sync";})[0];
        if(!app)return;
        easyUnsub=app.firestore().collection("aikm_admin").doc("easyShip").onSnapshot(function(d){easy=d.exists?d.data():{};render();},function(e){console.warn("Header: Easy Ship status unavailable",e);});
      }

      /* ---- alert rules ---- */
      function build(){
        var A=[],o=window.omsOrdersRaw||[],now=new Date(),t0=dayStart(now),m=awbMaps(o);

        /* Orders */
        var over={},cancelReq={},returns={};
        for(var i=0;i<o.length;i++){var x=o[i],st=x.status||"",id=x.channelOrderId||x.awb||i,age=(Date.now()-new Date(x.orderDate).getTime())/DAY;
          if(PEND.test(st)){var t=new Date(x.slaDate).getTime();if(t&&t<t0)over[id]=1;}
          if(st==="Cancel Init"&&age<7)cancelReq[id]=1;
          if(st==="Return Init"&&age<30)returns[id]=1;}
        var nOver=Object.keys(over).length,nCan=Object.keys(cancelReq).length,nRet=Object.keys(returns).length;
        if(nOver)A.push({k:"sla",c:"red",i:"ti-clock-exclamation",n:nOver,t:"Past SLA",tip:"Not shipped and SLA date has passed.",go:"omsorders"});

        /* Cancelled orders sitting in today's courier batch */
        var batch=(typeof courierScans!=="undefined"&&courierScans)||[],cb=[];
        batch.forEach(function(s){var r=findAwb(m,s.awb);if(r&&CANC.test(r.status||""))cb.push(s.awb+" · "+r.status);});
        if(cb.length)A.push({k:"cancelbatch",c:"red",i:"ti-package-off",n:cb.length,t:"Cancelled in pickup batch",tip:"Remove these before handing to the courier:\n"+cb.slice(0,12).join("\n"),go:"courier"});

        /* Cancel requested by buyer (last 7 days) */
        if(nCan)A.push({k:"cancelreq",c:"red",i:"ti-hand-stop",n:nCan,t:"Cancel requested",tip:"Buyer asked to cancel (last 7 days). Don't ship these.",go:"omsorders"});

        /* Handed over but not shipped */
        if(handover.list.length&&o.length){
          var cutoff=Date.now()-18*36e5,hn=[],done={};
          handover.list.forEach(function(h){if(done[h.awb]||h.at>cutoff)return;done[h.awb]=1;var r=findAwb(m,h.awb);if(r&&PEND.test(r.status||""))hn.push(h.awb+" · "+h.courier+" · "+r.status);});
          if(hn.length)A.push({k:"handover",c:"red",i:"ti-truck-off",n:hn.length,t:"Handed over, not shipped",tip:"Given to courier 18+ hrs ago, OMS still says not shipped:\n"+hn.slice(0,12).join("\n")+(hn.length>12?"\n+"+(hn.length-12)+" more":""),go:"courier"});
        }

        /* Easy Ship robot */
        if(easy){
          var L=easy.last||{},live=easy.live||{},fin=L.finishedAt?new Date(L.finishedAt).getTime():0;
          if(live.state==="failed"&&live.updatedAt&&Date.now()-new Date(live.updatedAt).getTime()<36*36e5)
            A.push({k:"esrobot",c:"red",i:"ti-robot-off",n:null,t:"Easy Ship robot failed",tip:live.step||"The last Easy Ship run stopped with an error.",go:"easyship"});
          if(fin&&Date.now()-fin<36*36e5){
            var ef=(L.failed||[]).length,ec=(L.check||[]).length;
            if(ef)A.push({k:"esfail",c:"red",i:"ti-alert-octagon",n:ef,t:"Easy Ship failed",tip:"Could not be packed in the last run (SLA "+(L.target||"")+"):\n"+(L.failed||[]).slice(0,10).map(function(f){return f.orderId+" · "+(f.reason||"");}).join("\n"),go:"easyship"});
            if(ec)A.push({k:"escheck",c:"amber",i:"ti-zoom-question",n:ec,t:"Easy Ship check manually",tip:"Easy Ship couldn't decide these — check by hand.",go:"easyship"});
          }
        }

        /* Courier (Nimbus) problems */
        var nd=typeof window.__ndRows==="function"?(window.__ndRows()||[]):[];
        if(nd.length){
          var pl=0,dl=0,ndr=0;nd.forEach(function(r){var f=r.flags||{};if(f.pickupLate&&r.cr&&r.cr.getTime&&r.cr.getTime()>=Date.now()-7*DAY)pl++;if(f.late)dl++;if(f.ndr)ndr++;});
          if(ndr)A.push({k:"ndr",c:"red",i:"ti-phone-x",n:ndr,t:"NDR / exception",tip:"Delivery failed or courier exception — call the buyer.",go:"nimbusdash"});
          if(dl)A.push({k:"late",c:"red",i:"ti-alarm",n:dl,t:"Delivery delayed",tip:"Past courier delivery date, or too long in transit.",go:"nimbusdash"});
          if(pl)A.push({k:"pickuplate",c:"amber",i:"ti-truck-loading",n:pl,t:"Pickup delayed",sub:"7 days",tip:"Shipments created in the last 7 days whose pickup date has passed, still not picked up.",go:"nimbusdash"});
        }

        /* Loss orders */
        if(typeof isOmsOrderLoss==="function"){
          var lossIds={},lossCut=Date.now()-7*DAY;
          for(var q=0;q<o.length;q++){var y=o[q],od=new Date(y.orderDate).getTime();if(od&&od>=lossCut&&isOmsOrderLoss(y))lossIds[y.channelOrderId||y.awb||q]=1;}
          var loss=Object.keys(lossIds).length;
          if(loss)A.push({k:"loss",c:"red",i:"ti-trending-down",n:loss,t:"Loss orders",sub:"7 days",tip:"Orders in the last 7 days selling below cost.",go:"lossorders"});
        }

        /* Amazon (summary saved by the Amazon page) */
        if(amazon){
          var bbN=0,bbL=0,ns=0,oos=0,tax=0,dup=0,parts=[];
          Object.keys(amazon).forEach(function(acct){var a=amazon[acct]||{};bbN+=a.notHeld||0;bbL+=a.lost||0;ns+=a.notSelling||0;oos+=a.outStock||0;tax+=a.taxIssues||0;dup+=a.duplicate||0;
            parts.push((a.name||acct)+" · checked "+(a.at?ago(a.at)+" ago":"—"));});
          var info="\n\n"+parts.join("\n")+"\n(Updates when the Amazon page is opened.)";
          if(bbN||bbL)A.push({k:"buybox",c:"red",i:"ti-shopping-cart-off",n:bbN,t:"Buy box lost",sub:bbL?bbL+" new":"",tip:"Listings where we don't hold the buy box."+info,url:"/pages/amazon"});
          if(ns)A.push({k:"notselling",c:"red",i:"ti-ban",n:ns,t:"Not selling",tip:"In stock on Amazon but no active offer from us."+info,url:"/pages/amazon"});
          if(oos)A.push({k:"amzoos",c:"amber",i:"ti-box-off",n:oos,t:"Amazon out of stock",tip:"Listings with 0 stock on Amazon."+info,url:"/pages/amazon"});
          if(dup)A.push({k:"amzdup",c:"amber",i:"ti-copy",n:dup,t:"Duplicate listings",tip:"Same ASIN listed more than once with stock."+info,url:"/pages/amazon"});
          if(tax)A.push({k:"amztax",c:"amber",i:"ti-file-alert",n:tax,t:"Tax / HSN issues",tip:"Listings with missing or wrong tax / HSN."+info,url:"/pages/amazon"});
        }

        /* LOTS (last 24 hrs) */
        var lp=(typeof lotsVendor!=="undefined"&&lotsVendor&&lotsVendor.products)||[];
        if(lp.length){
          var up=0,down=0,loos=0,since=Date.now()-DAY;
          for(var j=0;j<lp.length;j++){var p=lp[j];
            if(p.priceChangedAt&&new Date(p.priceChangedAt).getTime()>=since&&p.prevPrice!=null&&p.slabs&&p.slabs.length){var best=Math.min.apply(null,p.slabs.map(function(s){return Number(s.price);}));best>p.prevPrice?up++:down++;}
            if(p.stockEvent&&p.stockEvent.type==="oos"&&new Date(p.stockEvent.at).getTime()>=since)loos++;}
          if(up+down)A.push({k:"lotsprice",c:"red",i:"ti-receipt-rupee",n:up+down,t:"LOTS price changed",sub:(up?up+"↑ ":"")+(down?down+"↓":""),tip:"LOTS changed "+(up+down)+" prices in the last 24 hrs ("+up+" up, "+down+" down).",go:"lotsproducts"});
          if(loos)A.push({k:"lotsoos",c:"red",i:"ti-package-off",n:loos,t:"LOTS out of stock",tip:"Went out of stock at LOTS in the last 24 hrs.",go:"lotsproducts"});
        }

        /* Returns on the way */
        if(nRet)A.push({k:"returns",c:"amber",i:"ti-arrow-back-up",n:nRet,t:"Returns coming",tip:"Return started in the last 30 days — check when they arrive.",go:"omsorders"});

        /* OMS data stale */
        var d=window.__omsLastSyncedDate;
        if(d&&d.getTime&&Date.now()-d.getTime()>=45*60000)A.push({k:"stale",c:"amber",i:"ti-refresh-alert",n:null,t:"OMS not updated for "+ago(d.getTime()),tip:"Last OMS update: "+d.toLocaleString("en-IN")+". Check the sync badge.",go:"omsorders"});
        return A;
      }

      function syncState(){
        var p=document.querySelector(".app-header .sh-pill");
        if(!p) return {cls:"",txt:"Sync status",el:null};
        var cls=p.classList.contains("bad")?"bad":p.classList.contains("stale")?"stale":"";
        var t=(p.querySelector(".sh-dot")&&p.childNodes.length>1)?p.childNodes[1].textContent:p.textContent;
        return {cls:cls,txt:(t||"Sync status").trim(),el:p};
      }
      /* Firebase usage: one small read every 30 min (same record the sync panel uses) */
      function loadFb(){
        if(fbLoading||typeof fbDb==="undefined"||!fbDb)return;
        if(fbAt&&Date.now()-fbAt<30*60000)return;
        fbLoading=true;
        fbDb.collection("aikm_admin").doc("firebaseUsage").get().then(function(d){fbUse=d.exists?d.data():null;fbAt=Date.now();fbLoading=false;render();}).catch(function(){fbAt=Date.now();fbLoading=false;});
      }
      function fbStats(){
        var U=fbUse;if(!U||!U.projects)return null;
        var L=U.limits||{},best=null,lines=[];
        Object.keys(U.projects).forEach(function(k){var p=U.projects[k];if(!p||!p.ok)return;
          ["reads","writes","deletes"].forEach(function(m){var lim=Number(L[m])||1,used=Number(p[m])||0,pr=Number(p[m+"Projected"])||used,pct=Math.round(used/lim*100),pp=Math.round(pr/lim*100);
            if(!best||pct>best.pct)best={pct:pct,pp:pp,label:p.label||k,m:m};
            if(m==="reads"||pct>=50)lines.push((p.label||k)+" · "+m+": "+fmt(used)+" / "+fmt(lim)+" ("+pct+"%"+(pp>pct?", heading to "+pp+"%":"")+")");});});
        if(!best)return null;
        var c=U.cost||{},at=U.at&&U.at.toDate?U.at.toDate():null;
        return {pct:best.pct,pp:best.pp,top:best,cost:Number(c.monthInr)||0,costP:Number(c.monthProjectedInr)||0,budget:Number(U.budgetInr)||500,at:at,lines:lines};
      }
      /* show as many items as fit on each lane, then "+N more" (opens the full list) */
      function fitLanes(){
        ["aikmCList","aikmWList"].forEach(function(id){
          var box=$(id);if(!box)return;
          var old=box.querySelector(".more");if(old)old.remove();
          var items=[].slice.call(box.querySelectorAll(".aikm-li"));items.forEach(function(x){x.style.display="";});
          var br=box.getBoundingClientRect();if(!br.width)return;
          var limit=br.right-72,hidden=0;
          for(var i=0;i<items.length;i++){if(items[i].getBoundingClientRect().right>(i===items.length-1?br.right:limit)){for(var j=i;j<items.length;j++){items[j].style.display="none";hidden++;}break;}}
          if(hidden){var m=document.createElement("span");m.className="aikm-li more";m.setAttribute("data-more","1");m.setAttribute("role","button");m.tabIndex=0;m.textContent="+"+hidden+" more";box.appendChild(m);}
        });
      }
      function scoreOf(A){
        var s=100;A.forEach(function(a){s-=CRIT[a.k]?8:2;});
        return Math.max(0,Math.min(100,s));
      }
      function dayKey(d){return d.getFullYear()+"-"+(d.getMonth()+1)+"-"+d.getDate();}
      function trend(score){
        try{
          var k="aikm_ops_health",h=JSON.parse(localStorage.getItem(k)||"{}"),now=new Date(),y=new Date(now.getTime()-DAY);
          h[dayKey(now)]=score;
          Object.keys(h).forEach(function(d){ if(Object.keys(h).length>10) delete h[d]; });
          localStorage.setItem(k,JSON.stringify(h));
          var yv=h[dayKey(y)]; return (typeof yv==="number")?score-yv:null;
        }catch(e){return null;}
      }
      function rowHtml(a){
        return '<div class="aikm-pr" role="menuitem" tabindex="0" data-k="'+a.k+'" title="'+esc(a.tip)+'"><i class="ti '+a.i+'"></i><span class="lbl">'+esc(a.t)+(a.sub?' <small>· '+esc(a.sub)+'</small>':'')+'</span>'+(a.n!=null?'<span class="aikm-n">'+fmt(a.n)+'</span>':'')+'<i class="ti ti-arrow-up-right go"></i></div>';
      }
      function render(){
        var ops=$("aikmOps");if(!ops)return;
        if(!(window.omsOrdersRaw&&window.omsOrdersRaw.length))return;
        var A=build(),sy=syncState();
        var fs=fbStats();
        if(fs&&(fs.pct>=100||fs.cost>=fs.budget))A.unshift({k:"fbover",c:"red",i:"ti-flame",n:fs.pct,t:"Firebase over free limit",sub:fs.top.label+" "+fs.top.m,tip:fs.lines.join("\n"),fb:1});
        else if(fs&&(fs.pct>=80||fs.pp>=100))A.push({k:"fbnear",c:"amber",i:"ti-flame",n:fs.pct,t:"Firebase usage high",sub:fs.top.label+" "+fs.top.m+" %",tip:fs.lines.join("\n"),fb:1});
        if(sy.cls==="bad")A.unshift({k:"syncbad",c:"red",i:"ti-cloud-off",n:null,t:"Sync problem — "+sy.txt,tip:"One or more data syncs failed. Click to see which.",sync:1});
        A.forEach(function(a){a.crit=!!CRIT[a.k];});
        var crit=A.filter(function(a){return a.crit;}),watch=A.filter(function(a){return !a.crit;});
        lastA=A;
        var score=scoreOf(A),d=trend(score);
        ops.classList.toggle("is-good",score>=80);ops.classList.toggle("is-risk",score<60);
        $("aikmScore").textContent=score;
        $("aikmRingVal").setAttribute("stroke-dasharray",(138.2*score/100).toFixed(1)+" 138.2");
        $("aikmTag").textContent=score>=80?"Good":score>=60?"Fair":"At risk";
        var parts=["Ops health"];
        parts.push(crit.length?crit.length+" critical":"0 critical");
        parts.push(watch.length+" watch");
        if(d!==null&&d!==0)parts.push('<span class="'+(d>0?"up":"dn")+'"><i class="ti ti-trending-'+(d>0?"up":"down")+'"></i> '+(d>0?"+":"")+d+' vs yday</span>');
        $("aikmHsub").innerHTML=parts.join(" · ");
        /* lane 1: critical (sync + Firebase live in the status block) · lane 2: watch */
        var critBar=crit.filter(function(a){return !a.sync&&!a.fb;});
        var item=function(a,lbl){return '<span class="aikm-li" role="button" tabindex="0" data-k="'+a.k+'" title="'+esc(a.t+(a.sub?" · "+a.sub:"")+"\n"+a.tip)+'">'+(a.n!=null?'<b>'+fmt(a.n)+(a.fb?"%":"")+'</b>':'')+esc(lbl)+'</span>';};
        $("aikmCList").innerHTML=critBar.length?critBar.map(function(a){return item(a,CSHORT[a.k]||a.t);}).join(""):'<span class="aikm-li calm"><i class="ti ti-circle-check"></i> No critical issues — great</span>';
        $("aikmWList").innerHTML=watch.length?watch.map(function(a){return item(a,WSHORT[a.k]||a.t);}).join(""):'<span class="aikm-li calm">Nothing to watch</span>';
        fitLanes();
        /* sync + Firebase, always visible */
        var syb=$("aikmSy");syb.className="aikm-st aikm-sy"+(sy.cls?" "+sy.cls:"");$("aikmSyTxt").textContent=sy.txt;
        var fbe=$("aikmFb");
        if(fs){
          fbe.style.display="";
          fbe.className="aikm-st aikm-fb"+(fs.pct>=100||fs.cost>=fs.budget?" over":fs.pct>=80||fs.pp>=100?" near":"");
          $("aikmFbTxt").innerHTML='Firebase <span class="aikm-fbbar"><span style="width:'+Math.min(100,fs.pct)+'%"></span></span>'+fs.pct+'% <small>· ₹'+(fs.cost<10?fs.cost.toFixed(2):Math.round(fs.cost))+' this month</small>';
          fbe.title="Firebase usage today — highest: "+fs.top.label+" "+fs.top.m+" "+fs.pct+"% of the free daily limit"+(fs.pp>fs.pct?" (heading to "+fs.pp+"%)":"")+"\nThis month: ₹"+fs.cost.toFixed(2)+" of ₹"+fs.budget+" budget\n\n"+fs.lines.join("\n")+(fs.at?"\n\nUpdated "+ago(fs.at.getTime())+" ago":"");
        }else fbe.style.display="none";
        $("aikmAllTxt").innerHTML=A.length?'<span class="lg">All '+A.length+' issue'+(A.length>1?'s':'')+'</span><span class="sm">'+A.length+'</span>':'Details';
        var h='<div class="aikm-ph"><b>Today\'s issues</b><button type="button" class="aikm-sync '+sy.cls+'" data-sync="1" title="Open sync details"><i></i>'+esc(sy.txt)+'</button></div>';
        if(!A.length)h+='<div class="aikm-pe"><i class="ti ti-circle-check"></i>No open issues right now.</div>';
        if(crit.length)h+='<div class="aikm-pg">Critical · '+crit.length+'</div>'+crit.map(rowHtml).join("");
        if(watch.length)h+='<div class="aikm-pg w">Watch · '+watch.length+'</div>'+watch.map(rowHtml).join("");
        h+='<div class="aikm-pf">Score: 100 minus 8 per critical and 2 per watch issue. Sync and Firebase details: click the status in the bar. Hover a row for details.</div>';
        $("aikmPanel").innerHTML=h;
      }
      function open(k){
        var a=lastA.filter(function(x){return x.k===k;})[0];if(!a)return;
        closePanel();
        if(a.sync||a.fb){var p=syncState().el;if(p)p.click();return;}
        if(a.url)window.open(a.url,"_blank");else if(a.go)go(a.go);
      }
      function closePanel(){$("aikmPanel").hidden=true;$("aikmAllBtn").setAttribute("aria-expanded","false");}
      function togglePanel(){var p=$("aikmPanel"),show=p.hidden;if(show&&window.innerWidth>900){var r=$("aikmAllBtn").getBoundingClientRect();p.style.top=(r.bottom+10)+"px";p.style.right=Math.max(12,window.innerWidth-r.right)+"px";}p.hidden=!show;$("aikmAllBtn").setAttribute("aria-expanded",show?"true":"false");}
      function tick(){loadHandover();watchAmazon();watchEasyShip();loadFb();render();}
      function start(){
        var pn=$("aikmPanel");document.body.appendChild(pn);   /* live outside the header so nothing can clip it */
        pn.addEventListener("click",function(e){
          e.stopPropagation();
          var s=e.target.closest("[data-sync]");if(s){closePanel();var sp=syncState().el;if(sp)sp.click();return;}
          var r=e.target.closest("[data-k]");if(r)open(r.getAttribute("data-k"));
        });
        pn.addEventListener("keydown",function(e){var r=e.target.closest&&e.target.closest("[data-k]");if(e.key==="Enter"&&r)open(r.getAttribute("data-k"));});
        $("aikmAllBtn").addEventListener("click",function(e){e.stopPropagation();togglePanel();});
        $("aikmHealth").addEventListener("click",function(e){e.stopPropagation();togglePanel();});
        $("aikmFb").addEventListener("click",function(){var p=syncState().el;if(p)p.click();});
        $("aikmOps").addEventListener("click",function(e){
          var s=e.target.closest("[data-sync]");if(s){closePanel();var p=syncState().el;if(p)p.click();return;}
          if(e.target.closest("[data-more]")){e.stopPropagation();togglePanel();return;}
          var r=e.target.closest("[data-k]");if(r){e.stopPropagation();open(r.getAttribute("data-k"));}
        });
        $("aikmOps").addEventListener("keydown",function(e){var r=e.target.closest&&e.target.closest("[data-k]");if(e.key==="Enter"&&r)open(r.getAttribute("data-k"));});
        document.addEventListener("click",function(e){if(!e.target.closest(".aikm-allwrap")&&!e.target.closest("#aikmPanel"))closePanel();});
        document.addEventListener("keydown",function(e){if(e.key==="Escape")closePanel();});
        window.addEventListener("resize",function(){closePanel();fitLanes();});
        var lc=$("sidebarLossCount");if(lc)new MutationObserver(render).observe(lc,{childList:true,characterData:true,subtree:true});
        /* re-draw the moment the sync status changes */
        var shT=0,shObs=new MutationObserver(function(){clearTimeout(shT);shT=setTimeout(render,250);}),shHook=setInterval(function(){var sp=document.querySelector(".app-header .sh-pill");if(sp){shObs.observe(sp,{attributes:true,childList:true,subtree:true,characterData:true});clearInterval(shHook);}},1500);
        tick();
        setInterval(tick,30000);
        var tries=0,fast=setInterval(function(){tick();tries++;if((window.omsOrdersRaw&&window.omsOrdersRaw.length&&handover.at)||tries>60)clearInterval(fast);},2000);
      }
      if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",start);else start();
    })();
    </script>
