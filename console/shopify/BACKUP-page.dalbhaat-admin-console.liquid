<style>
html#aikm:not(.aikm-ready) body .app-shell{visibility:hidden;}
@media screen and (min-width:901px){
  html#aikm body .app-shell > .app-sidebar{
    position:fixed !important;left:0 !important;top:0 !important;bottom:0 !important;height:100vh !important;
    width:236px !important;min-width:0 !important;z-index:400 !important;
    overflow-x:hidden !important;overflow-y:auto !important;opacity:1 !important;pointer-events:auto !important;
    transition:none !important;scrollbar-width:none;
    box-shadow:12px 0 40px rgba(0,0,0,.35) !important;
  }
  html#aikm.aikm-ready body .app-shell > .app-sidebar{transition:width .2s ease, box-shadow .2s ease !important;}
  html#aikm body .app-shell > .app-sidebar::-webkit-scrollbar{display:none;}
  html#aikm body .app-shell > .app-main{margin-left:68px !important;width:calc(100% - 68px) !important;}
  html#aikm body .app-shell > .app-sidebar .topbar{position:relative;white-space:nowrap;min-height:74px;}
  html#aikm body .app-shell > .app-sidebar .tabbtn,
  html#aikm body .app-shell > .app-sidebar .backend-access{white-space:nowrap !important;}

  /* inner layout never changes width — the slim rail simply shows the icon column */
  html#aikm body .app-shell > .app-sidebar > *{width:216px !important;min-width:216px !important;flex-shrink:0 !important;box-sizing:border-box;}
  html#aikm body .app-shell > .app-sidebar .tabbar{padding:4px 2px !important;}
  html#aikm body .app-shell > .app-sidebar .tabbtn.active::before{left:-12px !important;}

  /* ---- slim (not hovered, not clicked open): icons only ---- */
  html#aikm:not(.aikm-rail-open) body .app-shell > .app-sidebar:not(:hover){width:68px !important;box-shadow:none !important;}
  html#aikm:not(.aikm-rail-open) body .app-shell > .app-sidebar:not(:hover) .topbar .logo-wrap,
  html#aikm:not(.aikm-rail-open) body .app-shell > .app-sidebar:not(:hover) .topbar > span,
  html#aikm:not(.aikm-rail-open) body .app-shell > .app-sidebar:not(:hover) .backend-access,
  html#aikm:not(.aikm-rail-open) body .app-shell > .app-sidebar:not(:hover) .tabbtn{color:transparent !important;}
  html#aikm:not(.aikm-rail-open) body .app-shell > .app-sidebar:not(:hover) .topbar .logo-wrap,
  html#aikm:not(.aikm-rail-open) body .app-shell > .app-sidebar:not(:hover) .topbar > span,
  html#aikm:not(.aikm-rail-open) body .app-shell > .app-sidebar:not(:hover) .backend-access{opacity:0 !important;pointer-events:none !important;}
  html#aikm:not(.aikm-rail-open) body .app-shell > .app-sidebar:not(:hover) .tabbtn .tab-ic{color:var(--x-side-text,#A7B1C4) !important;}
  html#aikm:not(.aikm-rail-open) body .app-shell > .app-sidebar:not(:hover) .tabbtn.active .tab-ic{color:#F3E2A6 !important;}
  html#aikm:not(.aikm-rail-open) body .app-shell > .app-sidebar:not(:hover) .tabbtn{background-clip:content-box;}
  html#aikm:not(.aikm-rail-open) body .app-shell > .app-sidebar:not(:hover) .topbar::after{content:"A" !important;position:absolute;left:7px;top:22px;width:34px;height:34px;border-radius:10px;
    display:flex !important;align-items:center;justify-content:center;font:700 17px/1 "Lexend",sans-serif;color:#1A1405;background:linear-gradient(135deg,#E9CC6E,#D4AF37) !important;opacity:1 !important;visibility:visible !important;z-index:2;}
  html#aikm:not(.aikm-rail-open) body .app-shell > .app-sidebar:not(:hover) .tabbtn .rtab-count{position:absolute !important;left:30px;top:6px;width:8px !important;height:8px !important;min-width:0 !important;padding:0 !important;font-size:0 !important;color:transparent !important;background:#F0787A !important;}
}
</style>
<script>
(function(){
  var d=document.documentElement;
  function ready(){ if(!d.classList.contains("aikm-ready")) d.classList.add("aikm-ready"); }
  document.addEventListener("DOMContentLoaded",function(){ requestAnimationFrame(ready); });
  setTimeout(ready,3000);
  // click on the slim menu opens it; picking a menu item or clicking outside closes it
  document.addEventListener("click",function(e){
    if(window.innerWidth<=900) return;
    var side=e.target.closest&&e.target.closest(".app-sidebar");
    if(!side){ d.classList.remove("aikm-rail-open"); return; }
    if(e.target.closest(".tabbtn, a, button")){ setTimeout(function(){ d.classList.remove("aikm-rail-open"); },150); return; }
    d.classList.toggle("aikm-rail-open");
  });
})();
</script>

