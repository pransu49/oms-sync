<script>let CATALOG,MRP_DATA,TAX_DATA,BARCODE_MAP,SLAB_DATA;(function(){var xhr=new XMLHttpRequest;xhr.open("GET","https://cdn.shopify.com/s/files/1/0737/1912/0040/files/counter-billing-data.json?v=1786525374",false);xhr.send(null);var d=JSON.parse(xhr.responseText);CATALOG=d.CATALOG;MRP_DATA=d.MRP_DATA;TAX_DATA=d.TAX_DATA;BARCODE_MAP=d.BARCODE_MAP;SLAB_DATA=d.SLAB_DATA})();const byCode=new Map;CATALOG.forEach((p=>byCode.set(p[0],p)));const CODE_TO_BARCODE={};for(const b in BARCODE_MAP){CODE_TO_BARCODE[BARCODE_MAP[b]]=b}const MRP_GAP_RULES=[{gapBelow:10,markup:3},{gapBelow:20,markup:5},{gapBelow:30,markup:8},{gapBelow:40,markup:12},{gapBelow:Infinity,markup:15}];const NO_MRP_MARKUP=5;function mrpGapPct(cost,mrp){return mrp>cost&&cost>0?(mrp-cost)/mrp*100:null}function markupFor(cost,mrp){const gap=mrpGapPct(cost,mrp);if(gap===null)return NO_MRP_MARKUP;for(const r of MRP_GAP_RULES){if(gap<r.gapBelow)return r.markup}return 15}function salePriceFor(cost,mrp){let price=cost*(1+markupFor(cost,mrp)/100);if(mrp>cost&&price>mrp)price=mrp;return Math.round(price*100)/100}const LOTS_SOURCES=[{key:"gn",label:"LOTS GN"},{key:"l62",label:"LOTS 62"}];const lotsData={gn:new Map,l62:new Map};const lotsMeta={};const lotsPrice={};const lotsSlabs={};var lotsInfo_={};let lotsLoaded=false;let barcodeMap={};let priceOverrides={};let futurePrices={};let fixedMeta={};let slabOverrides={};let lotsRawCost={};let mrpOverrides={};let nameOverrides={};let barcodeOverrides={};let lastBilledPrices={};let stockAdjust={};let expiryDates={};let customProducts={};let deletedProducts={};let billers=[];let currentBiller=null;let biz={address:"Shop No-4, Vill-Garhi Chaukhandi, Noida-201301",gstin:"09AEWFS5594P1ZI",phone:""};let invoiceLines=[];let editingInvoiceKey=null;let editingOriginalSnapshot=null;let currentDateKey="";function fmt(n){const r=Math.round(n*100)/100;return"₹"+(Number.isInteger(r)?r.toLocaleString("en-IN"):r.toLocaleString("en-IN",{minimumFractionDigits:2,maximumFractionDigits:2}))}function grandTotalOf(lines){const raw=lines.reduce(((s,l)=>s+l.qty*l.price),0);const grand=Math.round(raw);const roundOff=Math.round((grand-raw)*100)/100;const totalTax=Math.round(lines.reduce(((s,l)=>s+taxAmountFor(l.price,l.qty,l.taxRate||0)),0)*100)/100;return{raw:raw,grand:grand,roundOff:roundOff,totalTax:totalTax}}function todayKey(){const d=new Date;return d.getFullYear()+String(d.getMonth()+1).padStart(2,"0")+String(d.getDate()).padStart(2,"0")}function todayStr(){return(new Date).toLocaleDateString("en-GB",{day:"2-digit",month:"short",year:"numeric"})}const NS="counterBilling:";function safeLocalSet(key,val){try{localStorage.setItem(key,val);return true}catch(e){console.error("localStorage full, could not save: "+key,e);return false}}async function sget(key){try{const v=localStorage.getItem(NS+key);return v}catch(e){return null}}async function sset(key,val){try{localStorage.setItem(NS+key,val)}catch(e){console.error(e)}pushToCloud(key,val)}async function slist(prefix){const keys=[];for(let i=0;i<localStorage.length;i++){const k=localStorage.key(i);if(k&&k.startsWith(NS+prefix))keys.push(k.slice(NS.length))}return keys}const SYNC_CFG_KEY="counterBillingSyncCfg";let cloudDb=null,cloudShopId=null,cloudUnsub=null;const DEFAULT_SYNC_CFG={apiKey:"AIzaSyACRsJkY1D6guR1elO7dlMx79gxCF5r4ZM",authDomain:"sasta-store-pos.firebaseapp.com",projectId:"sasta-store-pos",storageBucket:"sasta-store-pos.firebasestorage.app",messagingSenderId:"833192653614",appId:"1:833192653614:web:42e0edc893d8ecfdea00bf",shopId:"sasta-store-pos"};function getSyncConfig(){try{if(localStorage.getItem(SYNC_CFG_KEY+"_off")==="1")return null;const raw=localStorage.getItem(SYNC_CFG_KEY);if(raw)return JSON.parse(raw)}catch(e){}return DEFAULT_SYNC_CFG}function setSyncStatus(text,ok){const el=document.getElementById("syncStatusLine");if(el){el.textContent=text;el.style.background=ok?"#e7f8ee":"#fdf1d8";el.style.color=ok?"#0f6b4c":"var(--gold-ink)"}const bigId=document.getElementById("syncShopIdBig");if(bigId){const cfg=getSyncConfig();if(cfg&&cfg.shopId){bigId.style.display="block";bigId.textContent="Shop ID: "+cfg.shopId}else bigId.style.display="none"}const copyBtn=document.getElementById("copyConnBtn");if(copyBtn)copyBtn.style.display=getSyncConfig()?"block":"none";const pill=document.getElementById("syncPill");const cfgForPill=getSyncConfig();if(pill){if(!cfgForPill){pill.textContent="● Sync off";pill.className="sync-pill"}else if(ok){pill.textContent="● Synced";pill.className="sync-pill on"}else{pill.textContent="● Sync issue";pill.className="sync-pill off"}}const banner=document.getElementById("syncIssueBanner");if(banner){if(cfgForPill&&!ok){banner.style.display="flex";document.getElementById("syncIssueBannerText").textContent="⚠ Sync issue — bills on this device may not be reaching other systems. "+text}else banner.style.display="none"}}function initCloudSync(){const cfg=getSyncConfig();if(!cfg||!cfg.apiKey||!cfg.projectId||!cfg.shopId){setSyncStatus("Not connected — this device is working offline only.",false);return}if(typeof firebase==="undefined"){setSyncStatus("Could not load the sync library — your internet or an ad-blocker may be blocking gstatic.com/firebaseio.com. Try disabling any ad-blocker, or try a different network, then reload this page.",false);return}try{if(!firebase.apps.length)firebase.initializeApp(cfg);cloudDb=firebase.firestore();cloudShopId=cfg.shopId;if(cloudUnsub)cloudUnsub();cloudUnsub=cloudDb.collection("shops").doc(cloudShopId).collection("kv").onSnapshot((snap=>{let changed=false;let quotaFailed=false;snap.docChanges().forEach((change=>{if(change.type==="removed")return;const key=change.doc.id;const data=change.doc.data();if(!data||typeof data.v!=="string")return;if(LEGACY_SYNC_KEYS.includes(key)){try{localStorage.removeItem(NS+key)}catch(e){}return}if(localStorage.getItem(NS+key)!==data.v){try{localStorage.setItem(NS+key,data.v);changed=true}catch(e){quotaFailed=true;console.error("localStorage full, could not save key: "+key,e)}}}));if(changed)scheduleCloudRefresh();if(quotaFailed){setSyncStatus("⚠ This browser's storage is full — some data (e.g. custom products or price history) couldn't be saved here. Clear old browser data, or use a different browser on this device.",false)}else{setSyncStatus('Connected — syncing live with other systems on "'+cloudShopId+'".',true)}const backfillFlag="counterBillingSyncBackfilled:"+cloudShopId;if(!localStorage.getItem(backfillFlag)){safeLocalSet(backfillFlag,"1");setTimeout((()=>{pushLocalSnapshotToCloud()}),3e3)}}),(err=>{console.error(err);const code=err&&err.code?err.code:"";let msg="Connected, but had trouble syncing (check internet). Will retry automatically.";if(code==="permission-denied")msg="Blocked by Firestore rules — go to Firebase Console → Firestore → Rules and make sure it still allows read/write (test-mode rules expire after 30 days).";setSyncStatus(msg+" ["+code+"]",false)}))}catch(e){console.error(e);setSyncStatus("Could not connect — "+(e&&e.message?e.message:"please double-check the pasted details")+".",false)}}const LEGACY_SYNC_KEYS=["price-overrides","slab-overrides","lots-raw-cost"];let __cloudRefreshTimer=null;function scheduleCloudRefresh(){clearTimeout(__cloudRefreshTimer);__cloudRefreshTimer=setTimeout((async()=>{await loadState();renderLines();renderRecentBills();renderUdhaarList();renderHeldBills();renderOrderList();renderFixedPrices()}),400)}async function pushLocalSnapshotToCloud(){if(!cloudDb||!cloudShopId)return{pushed:0,failed:0,error:null};const entries=[];for(let i=0;i<localStorage.length;i++){const k=localStorage.key(i);if(!k||!k.startsWith(NS))continue;const val=localStorage.getItem(k);if(val!=null)entries.push([k.slice(NS.length),val])}const chunkSize=400;let pushed=0,failed=0,lastError=null;for(let i=0;i<entries.length;i+=chunkSize){const chunk=entries.slice(i,i+chunkSize);const batch=cloudDb.batch();chunk.forEach((([key,val])=>{const ref=cloudDb.collection("shops").doc(cloudShopId).collection("kv").doc(key);batch.set(ref,{v:val,updatedAt:firebase.firestore.FieldValue.serverTimestamp()},{merge:true})}));try{await batch.commit();pushed+=chunk.length}catch(e){console.error("resync chunk failed",e);failed+=chunk.length;lastError=e}}return{pushed:pushed,failed:failed,error:lastError}}async function forceFullResync(){const msg=document.getElementById("resyncMsg");if(!cloudDb||!cloudShopId){if(msg)msg.textContent="Connect Cloud Sync first.";return}if(!confirm("This pushes everything on THIS system up to the cloud, so other connected systems pick it up. Use this on the system that has the missing bills or data. Continue?"))return;if(msg)msg.textContent="Pushing this device's data to the cloud…";const{pushed:pushed,failed:failed,error:error}=await pushLocalSnapshotToCloud();if(failed>0){const code=error&&error.code?` [${error.code}]`:"";if(msg)msg.textContent=`⚠ Pushed ${pushed}, but ${failed} FAILED${code} — likely blocked by Firestore rules. Check Firebase Console → Firestore → Rules.`;showToast("Resync had errors — see message below")}else{if(msg)msg.textContent=`Done — pushed ${pushed} record${pushed!==1?"s":""} to the cloud.`;showToast("Resync complete")}}async function checkSyncHealth(){const msg=document.getElementById("syncHealthMsg");if(!cloudDb||!cloudShopId){if(msg)msg.textContent="Connect Cloud Sync first.";return}if(msg)msg.textContent="Checking… (this fetches fresh from the cloud, not the local cache)";let localTotal=0,localInvoices=0;for(let i=0;i<localStorage.length;i++){const k=localStorage.key(i);if(!k||!k.startsWith(NS))continue;localTotal++;if(k.startsWith(NS+"invoice:"))localInvoices++}try{const snap=await cloudDb.collection("shops").doc(cloudShopId).collection("kv").get({source:"server"});let cloudTotal=0,cloudInvoices=0;snap.forEach((doc=>{cloudTotal++;if(doc.id.startsWith("invoice:"))cloudInvoices++}));if(msg)msg.innerHTML=`Shop ID <b>${cloudShopId}</b> — Cloud has <b>${cloudTotal}</b> records (${cloudInvoices} bills). This device has <b>${localTotal}</b> records (${localInvoices} bills) locally.`+(cloudTotal===0?"<br>⚠ Cloud is empty — nothing has ever reached Firestore for this Shop ID. Try Force full resync, then check for an error.":cloudInvoices>localInvoices?"<br>ℹ Cloud has more bills than this device — reload the page to pull them down.":cloudInvoices<localInvoices?"<br>ℹ This device has bills the cloud doesn't — press Force full resync.":"<br>✓ Bill counts match — this device is fully in sync.")}catch(e){console.error(e);const code=e&&e.code?e.code:"";if(msg)msg.innerHTML=`⚠ Could not read from the cloud [${code}]. `+(code==="permission-denied"?"Blocked by Firestore rules — go to Firebase Console → Firestore → Rules and check they allow read/write.":"Check your internet connection and try again.")}}function pushToCloud(key,val){if(!cloudDb||!cloudShopId)return;cloudDb.collection("shops").doc(cloudShopId).collection("kv").doc(key).set({v:val,updatedAt:firebase.firestore.FieldValue.serverTimestamp()},{merge:true}).catch((e=>console.error("cloud push failed",e)))}function saveCloudSyncConfig(){const cfg={apiKey:document.getElementById("syncApiKey").value.trim(),authDomain:document.getElementById("syncAuthDomain").value.trim(),projectId:document.getElementById("syncProjectId").value.trim(),storageBucket:document.getElementById("syncStorageBucket").value.trim(),messagingSenderId:document.getElementById("syncSenderId").value.trim(),appId:document.getElementById("syncAppId").value.trim(),shopId:document.getElementById("syncShopId").value.trim().toLowerCase().replace(/\s+/g,"-")};if(!cfg.apiKey||!cfg.projectId||!cfg.appId||!cfg.shopId){document.getElementById("syncMsg").textContent="Please fill in at least apiKey, projectId, appId and Shop ID.";return}safeLocalSet(SYNC_CFG_KEY,JSON.stringify(cfg));localStorage.removeItem(SYNC_CFG_KEY+"_off");document.getElementById("syncMsg").textContent="Saved — connecting…";if(typeof firebase==="undefined"){setTimeout(initCloudSync,1500)}else{initCloudSync()}}function disconnectClou